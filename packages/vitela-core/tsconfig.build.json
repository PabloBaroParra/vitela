{
  // The public entry and the client (DOM side) into dist/, with declarations.
  "extends": "./tsconfig.lib.json",
  "compilerOptions": {
    "tsBuildInfoFile": null,
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true
  },
  "exclude": ["src/worker", "src/generated", "src/**/*.test.ts"]
}
