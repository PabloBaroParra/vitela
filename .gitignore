*.pdb
.DS_Store
Thumbs.db

# Personal / local-only files — this repo's full history will be public.
CurriculumPabloBaro_EN.pdf

# Local AI-assistant tooling and caches (not part of the project)
.claude/
.agents/
.atl/
skills-lock.json

# Python bytecode cache (scripts/check_readme_tables.py and friends)
__pycache__/

# IDE
.vscode/
.vs/
.idea/
*.iml

# Windows shell (future) build artifacts
apps/windows/**/bin/
apps/windows/**/obj/
apps/windows/Pdf.Windows/Generated/
apps/windows/Pdf.Windows/Native/

# Android shell build artifacts. PDFium stays an externally supplied runtime
# prerequisite and is never committed.
apps/android/.gradle/
apps/android/**/build/
apps/android/app/src/main/jniLibs/
apps/android/local.properties

# macOS shell build artifacts. The shared scheme under xcshareddata/ IS tracked
# — CI drives `xcodebuild -scheme Vitela` and must not depend on autocreation.
apps/macos/.build/
apps/macos/DerivedData/
apps/macos/Generated/
apps/macos/Vitela.xcodeproj/xcuserdata/
apps/macos/Vitela.xcodeproj/project.xcworkspace/
build/Vitela.app/

# iOS shell build artifacts. As on macOS, the shared scheme under xcshareddata/
# IS tracked — CI drives `xcodebuild -scheme VitelaIOS`.
apps/ios/DerivedData/
apps/ios/Generated/
apps/ios/VitelaIOS.xcodeproj/xcuserdata/
apps/ios/VitelaIOS.xcodeproj/project.xcworkspace/

# uniffi-bindgen-cs spike (Batch 1) — C# build output + regenerated bindings
spikes/uniffi-cs/csharp-host/bin/
spikes/uniffi-cs/csharp-host/obj/
spikes/uniffi-cs/csharp-host/generated/

# pdfium prebuilt binary (Batch 3, T-015..T-021) — downloaded from
# bblanchon/pdfium-binaries per design.md's "PDFium Binary Distribution";
# never committed. See core/pdf-render/vendor/pdfium/README.md. Ignore
# everything in the extracted release tree, then re-allow the README we
# authored ourselves.
core/pdf-render/vendor/pdfium/*
!core/pdf-render/vendor/pdfium/README.md

# Same deal per Apple platform: iOS device and simulator are separate binaries,
# so they cannot share the one vendor directory above.
core/pdf-render/vendor/pdfium-iphonesimulator/
core/pdf-render/vendor/pdfium-iphoneos/

# Perf-harness fixture (Batch 3, T-021) — generated by `gen-fixtures`, not
# committed (would be ~50MB per spec.md's "Large-File Performance").
tests/fixtures/large/

# Local Linux distribution outputs and verification receipts (T-053).
build/linux/
