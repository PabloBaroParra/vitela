            <SolidColorBrush x:Key="VitelaDisabledFillBrush" Color="#F5F4F7" />
            <SolidColorBrush x:Key="VitelaDisabledBorderBrush" Color="#EAE8EF" />
            <SolidColorBrush x:Key="VitelaCoverSheetBrush" Color="#F1EEF6" />

            <!-- WinUI accent family -->
            <Color x:Key="SystemAccentColor">#6B4EFF</Color>
