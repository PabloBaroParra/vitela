            <SolidColorBrush x:Key="VitelaAccentSoftBrush" Color="#EEE9FA" />
            <SolidColorBrush x:Key="VitelaCheckedBrush" Color="#F2EDFF" />
            <SolidColorBrush x:Key="VitelaAccentBorderBrush" Color="#DED3FF" />
            <SolidColorBrush x:Key="VitelaSuccessBrush" Color="#1F8A4C" />
            <!-- Home tool tiles and hovered recent cards (.tool-tile, .recent-card:hover) -->
            <SolidColorBrush x:Key="VitelaTileBrush" Color="#F6F4FD" />
            <SolidColorBrush x:Key="VitelaTileBorderBrush" Color="#E7E2FB" />
            <SolidColorBrush x:Key="VitelaCardHoverBrush" Color="#FAF9FE" />
