<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The Vitela palette, defined ONCE. Light is the Linux shell's CSS
        verbatim (apps/linux-gtk/src/app/shell.rs, home/mod.rs); Dark is the
        Obsidian-derived variant. The shell follows the system theme, so there
        is no RequestedTheme anywhere: every colour in the app is a
        {ThemeResource Vitela...Brush}, or a WinUI resource re-pointed here so
        built-in controls stop using the system accent (pink on this machine).

        Light and Dark must define exactly the same keys (ThemeParityTests
        checks it): a role missing from one variant silently falls back to a
        WinUI default colour in that theme only.

        The variants are keyed Light/Dark explicitly. "Default" is not a synonym
        for Light; it is what XAML uses for a variant with no entry.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- Roles -->
            <SolidColorBrush x:Key="VitelaWindowBackgroundBrush" Color="#F8F7FB" />
            <SolidColorBrush x:Key="VitelaSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="VitelaInputBackgroundBrush" Color="#FCFBFE" />
            <SolidColorBrush x:Key="VitelaEditorBackgroundBrush" Color="#F2F0F5" />
            <SolidColorBrush x:Key="VitelaCanvasBackgroundBrush" Color="#E9E6EC" />
            <SolidColorBrush x:Key="VitelaHairlineBrush" Color="#E3E0E9" />
            <SolidColorBrush x:Key="VitelaInputBorderBrush" Color="#DED9E9" />
            <SolidColorBrush x:Key="VitelaStrongSeparatorBrush" Color="#C9C2E0" />
            <SolidColorBrush x:Key="VitelaHoverBrush" Color="#F5F3FA" />
            <SolidColorBrush x:Key="VitelaTextPrimaryBrush" Color="#302D3A" />
            <SolidColorBrush x:Key="VitelaTextSecondaryBrush" Color="#51496A" />
            <SolidColorBrush x:Key="VitelaTextHintBrush" Color="#625B72" />
            <SolidColorBrush x:Key="VitelaMutedBrush" Color="#A49FB3" />
            <SolidColorBrush x:Key="VitelaAccentBrush" Color="#6B4EFF" />
            <SolidColorBrush x:Key="VitelaAccentFillBrush" Color="#6B4EFF" />
            <SolidColorBrush x:Key="VitelaAccentFillHoverBrush" Color="#5A3EE6" />
