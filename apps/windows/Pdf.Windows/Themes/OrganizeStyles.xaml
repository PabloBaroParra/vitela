<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Organize screen, both views. Ports ORGANIZE_CSS (organize/documents/style.rs);
        the class name is in each comment. Colours come only from Palette.xaml.
    -->

    <!-- .organize-card, .organize-block -->
    <Style x:Key="OrganizeCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource VitelaSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource VitelaHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <!-- .organize-thumb, .organize-cover -->
    <Style x:Key="OrganizeThumbStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource VitelaCanvasBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- .organize-cover-sheet: the two empty sheets peeking out behind a cover -->
    <Style x:Key="OrganizeCoverSheetStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource VitelaCoverSheetBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource VitelaHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- .organize-block-name -->
    <Style x:Key="OrganizeBlockNameStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource VitelaTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- .organize-block-meta -->
    <Style x:Key="OrganizeBlockMetaStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource VitelaTextHintBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- .organize-card-source -->
    <Style x:Key="OrganizeCardSourceStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource VitelaTextHintBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- .organize-gap: keeps its height idle; only the colour changes -->
    <Style x:Key="OrganizeGapStyle" TargetType="Border">
        <Setter Property="Height" Value="12" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- .organize-view-switch button: quiet until checked -->
    <Style x:Key="OrganizeSwitchToggleStyle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{ThemeResource VitelaTextHintBrush}" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="16,4" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root" Background="Transparent" BorderBrush="{ThemeResource VitelaHairlineBrush}" BorderThickness="1"
                            CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource VitelaHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource VitelaAccentSoftBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource VitelaMutedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource VitelaCheckedBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource VitelaAccentBorderBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource VitelaTextPrimaryBrush}" />
                                        <Setter Target="Presenter.FontWeight" Value="SemiBold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource VitelaCheckedBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource VitelaAccentBorderBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource VitelaTextPrimaryBrush}" />
                                        <Setter Target="Presenter.FontWeight" Value="SemiBold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource VitelaCheckedBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource VitelaAccentBorderBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource VitelaTextPrimaryBrush}" />
                                        <Setter Target="Presenter.FontWeight" Value="SemiBold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource VitelaCheckedBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource VitelaMutedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The Organize heading, matching .panel-heading's weight -->
    <Style x:Key="OrganizeHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{ThemeResource VitelaTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="OrganizeHintStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource VitelaTextHintBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
