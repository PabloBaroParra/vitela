<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Shell chrome: the app rail, the status bar and the editor dividers.
        Ports shell.rs SHELL_CSS. Colours come only from Palette.xaml.
    -->

    <!-- .app-rail-item: a bordered button on the surface; active = accent-soft fill, accent border, bold accent text. -->
    <Style x:Key="RailItemStyle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{ThemeResource VitelaTextSecondaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root" Background="{ThemeResource VitelaSurfaceBrush}" BorderBrush="{ThemeResource VitelaHairlineBrush}" BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource VitelaAccentSoftBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource VitelaAccentSoftBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource VitelaMutedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource VitelaAccentSoftBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource VitelaAccentBorderBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource VitelaAccentBrush}" />
                                        <Setter Target="Presenter.FontWeight" Value="Bold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource VitelaAccentSoftBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource VitelaAccentBorderBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource VitelaAccentBrush}" />
                                        <Setter Target="Presenter.FontWeight" Value="Bold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource VitelaAccentSoftBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource VitelaAccentBorderBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource VitelaAccentBrush}" />
                                        <Setter Target="Presenter.FontWeight" Value="Bold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource VitelaAccentSoftBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource VitelaMutedBrush}" />
                                        <Setter Target="Presenter.FontWeight" Value="Bold" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .app-rail-separator -->
    <Style x:Key="RailSeparatorStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="2,6" />
        <Setter Property="Background" Value="{ThemeResource VitelaHairlineBrush}" />
    </Style>

    <!-- .app-rail: surface with a hairline on its right edge. -->
    <Style x:Key="RailContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource VitelaSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource VitelaHairlineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <!-- .brand-word -->
    <Style x:Key="BrandWordStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource VitelaAccentBrush}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- .status-bar -->
    <Style x:Key="StatusBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource VitelaSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource VitelaHairlineBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style x:Key="StatusTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource VitelaTextHintBrush}" />
    </Style>

    <!-- .editor-toolbar: white strip with a hairline under it. -->
    <Style x:Key="EditorToolbarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource VitelaSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource VitelaHairlineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <!-- .editor-main -->
    <Style x:Key="EditorMainStyle" TargetType="Grid">
        <Setter Property="Background" Value="{ThemeResource VitelaEditorBackgroundBrush}" />
    </Style>

    <!-- Both editor side-column dividers: a focusable 16px hit target drawn as a 2px grip. -->
    <Style x:Key="SideColumnDividerStyle" TargetType="Thumb">
        <Setter Property="Width" Value="16" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="{TemplateBinding Background}">
                        <Border Width="2" HorizontalAlignment="Center" Background="{ThemeResource VitelaStrongSeparatorBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
