<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Shell chrome: the mode bar, the status bar and the editor dividers.
        Ports shell.rs SHELL_CSS. Colours come only from Palette.xaml.
    -->

    <!--
        .mode-bar button: a borderless pill on the bar; hover = accent-soft fill;
        the current mode (:checked) = the checked fill, accent border, bold accent
        text — the editor toolbar's :checked tokens. ButtonBase, so the place
        modes (ToggleButton) and Protect (a plain Button) share one look.
    -->
    <Style x:Key="ModeTabStyle" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{ThemeResource VitelaTextSecondaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Root" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource VitelaAccentSoftBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource VitelaAccentSoftBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource VitelaMutedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource VitelaCheckedBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource VitelaAccentBorderBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource VitelaAccentBrush}" />
                                        <Setter Target="Presenter.FontWeight" Value="Bold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource VitelaCheckedBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource VitelaAccentBorderBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource VitelaAccentBrush}" />
                                        <Setter Target="Presenter.FontWeight" Value="Bold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource VitelaCheckedBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource VitelaAccentBorderBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource VitelaAccentBrush}" />
                                        <Setter Target="Presenter.FontWeight" Value="Bold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource VitelaCheckedBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{ThemeResource VitelaMutedBrush}" />
                                        <Setter Target="Presenter.FontWeight" Value="Bold" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .mode-bar: surface with a hairline on its bottom edge. -->
    <Style x:Key="ModeBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource VitelaSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource VitelaHairlineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <!-- .brand-word -->
    <Style x:Key="BrandWordStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource VitelaAccentBrush}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- .status-bar -->
    <Style x:Key="StatusBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource VitelaSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource VitelaHairlineBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style x:Key="StatusTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource VitelaTextHintBrush}" />
    </Style>

    <!-- .editor-toolbar: white strip with a hairline under it. -->
    <Style x:Key="EditorToolbarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource VitelaSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource VitelaHairlineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <!-- .editor-main -->
    <Style x:Key="EditorMainStyle" TargetType="Grid">
        <Setter Property="Background" Value="{ThemeResource VitelaEditorBackgroundBrush}" />
    </Style>

    <!-- Both editor side-column dividers: a focusable 16px hit target drawn as a 2px grip. -->
    <Style x:Key="SideColumnDividerStyle" TargetType="Thumb">
        <Setter Property="Width" Value="16" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="{TemplateBinding Background}">
                        <Border Width="2" HorizontalAlignment="Center" Background="{ThemeResource VitelaStrongSeparatorBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
