<Application
    x:Class="Pdf.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                The brand mark, picked per theme. "Default" is the key XAML
                applies under the dark theme — it is not a synonym for "Light",
                so the light variant needs its own explicit entry below.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SvgImageSource x:Key="AppMarkImageSource" UriSource="ms-appx:///Assets/vitela-app-mark-dark.svg" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SvgImageSource x:Key="AppMarkImageSource" UriSource="ms-appx:///Assets/vitela-app-mark.svg" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
