<Application
    x:Class="Pdf.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!--
                    Order matters: Palette re-points WinUI's own brush keys, so it
                    has to come after XamlControlsResources to win. It also owns the
                    per-theme brand mark. Follows the system theme; no RequestedTheme.
                -->
                <ResourceDictionary Source="Themes/Palette.xaml" />
                <ResourceDictionary Source="Themes/ShellStyles.xaml" />
                <ResourceDictionary Source="Themes/HomeStyles.xaml" />
                <ResourceDictionary Source="Themes/EditStyles.xaml" />
                <ResourceDictionary Source="Themes/OrganizeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
