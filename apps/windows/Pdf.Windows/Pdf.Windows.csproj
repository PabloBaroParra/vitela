<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Exe icon (Explorer, pinned taskbar button). Regenerate: python scripts/windows-app-icon.py -->
    <ApplicationIcon>vitela.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Microsoft Store build: the same app as an MSIX, opted into with
    -p:VitelaStorePackage=true by scripts/package-windows-store.ps1. Every
    other build (F5, CI, the signed zip) stays unpackaged.

    Unsigned on purpose: the Store re-signs what it ships, and Partner Center
    takes the plain .msix. The Windows App SDK runtime is a
    framework dependency the Store installs alongside the app, so only .NET is
    self-contained here.

    VitelaPdfiumDll is the verified pdfium.dll the script extracts; it lands at
    the package root, which is AppContext.BaseDirectory at run time, where
    BundledPdfium already looks for it.
  -->
  <PropertyGroup Condition="'$(VitelaStorePackage)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxBundle>Never</AppxBundle>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <!--
      The script moves bin/obj under build\windows-store. The SDK only excludes
      the *current* output paths from its globs, so the project's own bin\ and
      obj\ (left by ordinary builds) would be compiled in a second time.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <!--
    WinUI globs images in as Content by default, which would ship the Store
    tiles inside every unpackaged build (and the zip). Drop them everywhere,
    then add them back for the MSIX alone.
  -->
  <ItemGroup>
    <Content Remove="Package\**" />
    <None Remove="Package\**" />
    <None Remove="Package.appxmanifest" />
  </ItemGroup>
  <ItemGroup Condition="'$(VitelaStorePackage)' == 'true'">
    <!-- An item, not a property: when set, the SDK skips its Package.appxmanifest default. -->
    <AppxManifest Include="$(VitelaAppxManifest)" Condition="'$(VitelaAppxManifest)' != ''" />
    <Content Include="Package\Images\*.png" />
    <None Include="$(VitelaPdfiumDll)" Condition="'$(VitelaPdfiumDll)' != ''" CopyToOutputDirectory="PreserveNewest" TargetPath="pdfium.dll" />
    <None Include="$(VitelaLicensesDir)\**\*" Condition="'$(VitelaLicensesDir)' != ''" CopyToOutputDirectory="PreserveNewest" LinkBase="licenses" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Native\pdf_ffi.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="pdf_ffi.dll" />
  </ItemGroup>

  <!--
    The sample document shipped with every shell. Linked from the shared
    assets/ directory rather than copied here, so all platforms package the
    byte-identical file produced by `cargo run -p gen-sample`.

    Declared as None with a TargetPath, matching how pdf_ffi.dll is handled
    above: this shell is unpackaged (WindowsPackageType=None) and reads the
    file straight off disk next to the executable, so a plain copy-to-output
    is all it needs — no resource indexing.
  -->
  <ItemGroup>
    <None Include="..\..\..\assets\sample\vitela-sample.pdf" CopyToOutputDirectory="PreserveNewest" TargetPath="Assets\vitela-sample.pdf" />
    <None Include="..\..\..\assets\sample\aes_128_user_and_owner.pdf" CopyToOutputDirectory="PreserveNewest" TargetPath="Assets\aes_128_user_and_owner.pdf" />
    <None Include="..\..\..\assets\sample\rc4_128_user_and_owner.pdf" CopyToOutputDirectory="PreserveNewest" TargetPath="Assets\rc4_128_user_and_owner.pdf" />
  </ItemGroup>

  <!--
    Brand mark, one file per theme. The navy reads on the light theme and
    vanishes on the dark one, so App.xaml swaps them through a
    ThemeDictionaries entry rather than tinting at runtime: SvgImageSource
    rasterises the file as authored and honours neither currentColor nor
    ThemeResource, so the fill has to be baked per variant.

    Linked from the shared assets/ directory for the same reason as the sample
    above — the GTK4 shell draws the same two files — and copied to output
    because this shell is unpackaged and loads them off disk next to the
    executable. TargetPath keeps them at Assets\, where App.xaml expects them.
  -->
  <ItemGroup>
    <None Include="..\..\..\assets\brand\vitela-app-mark.svg" CopyToOutputDirectory="PreserveNewest" TargetPath="Assets\vitela-app-mark.svg" />
    <None Include="..\..\..\assets\brand\vitela-app-mark-dark.svg" CopyToOutputDirectory="PreserveNewest" TargetPath="Assets\vitela-app-mark-dark.svg" />
    <!-- The running window's icon (AppWindow.SetIcon in MainWindow.Chrome.cs). -->
    <None Include="vitela.ico" CopyToOutputDirectory="PreserveNewest" TargetPath="Assets\vitela.ico" />
  </ItemGroup>
</Project>
