<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Native\pdf_ffi.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="pdf_ffi.dll" />
  </ItemGroup>

  <!--
    The sample document shipped with every shell. Linked from the shared
    assets/ directory rather than copied here, so all platforms package the
    byte-identical file produced by `cargo run -p gen-sample`.

    Declared as None with a TargetPath, matching how pdf_ffi.dll is handled
    above: this shell is unpackaged (WindowsPackageType=None) and reads the
    file straight off disk next to the executable, so a plain copy-to-output
    is all it needs — no resource indexing.
  -->
  <ItemGroup>
    <None Include="..\..\..\assets\sample\vitela-sample.pdf" CopyToOutputDirectory="PreserveNewest" TargetPath="Assets\vitela-sample.pdf" />
    <None Include="..\..\..\assets\sample\aes_128_user_and_owner.pdf" CopyToOutputDirectory="PreserveNewest" TargetPath="Assets\aes_128_user_and_owner.pdf" />
    <None Include="..\..\..\assets\sample\rc4_128_user_and_owner.pdf" CopyToOutputDirectory="PreserveNewest" TargetPath="Assets\rc4_128_user_and_owner.pdf" />
  </ItemGroup>

  <!--
    Brand mark, one file per theme. The navy reads on the light theme and
    vanishes on the dark one, so App.xaml swaps them through a
    ThemeDictionaries entry rather than tinting at runtime: SvgImageSource
    rasterises the file as authored and honours neither currentColor nor
    ThemeResource, so the fill has to be baked per variant.

    Linked from the shared assets/ directory for the same reason as the sample
    above — the GTK4 shell draws the same two files — and copied to output
    because this shell is unpackaged and loads them off disk next to the
    executable. TargetPath keeps them at Assets\, where App.xaml expects them.
  -->
  <ItemGroup>
    <None Include="..\..\..\assets\brand\vitela-app-mark.svg" CopyToOutputDirectory="PreserveNewest" TargetPath="Assets\vitela-app-mark.svg" />
    <None Include="..\..\..\assets\brand\vitela-app-mark-dark.svg" CopyToOutputDirectory="PreserveNewest" TargetPath="Assets\vitela-app-mark-dark.svg" />
  </ItemGroup>
</Project>
