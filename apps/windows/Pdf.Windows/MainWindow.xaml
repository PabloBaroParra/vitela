<Window
    x:Class="Pdf.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PDF">
    <Grid Padding="20" RowSpacing="16" RowDefinitions="Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="OpenButton" Click="OpenButton_Click">Open</Button>
            <TextBlock x:Name="DocumentTitle" VerticalAlignment="Center" Text="No document open" />
            <TextBlock x:Name="PageCounter" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1">
            <ProgressRing x:Name="BusyIndicator" IsActive="False" Visibility="Collapsed" />
            <TextBlock x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Open a PDF to begin." />
            <TextBlock x:Name="ErrorState" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
            <ScrollViewer
                x:Name="PageScroller"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed"
                ViewChanged="PageScroller_ViewChanged"
                SizeChanged="PageScroller_SizeChanged">
                <StackPanel x:Name="PageStack" HorizontalAlignment="Center" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
