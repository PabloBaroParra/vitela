<Window
    x:Class="Pdf.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PDF">
    <Grid Padding="20" RowSpacing="16" RowDefinitions="Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="OpenButton" Click="OpenButton_Click">Open</Button>
            <Button x:Name="OpenSampleButton" Click="OpenSampleButton_Click">Open sample</Button>
            <Button x:Name="PrintButton" Click="PrintButton_Click">Print</Button>
            <TextBlock x:Name="DocumentTitle" VerticalAlignment="Center" Text="No document open" />
            <TextBlock x:Name="PageCounter" VerticalAlignment="Center" />
            <Button x:Name="ZoomOutButton" Click="ZoomOutButton_Click" ToolTipService.ToolTip="Zoom out">&#x2212;</Button>
            <TextBlock x:Name="ZoomLevel" VerticalAlignment="Center" MinWidth="110" />
            <Button x:Name="ZoomInButton" Click="ZoomInButton_Click" ToolTipService.ToolTip="Zoom in">&#x002B;</Button>
            <Button x:Name="FitWidthButton" Click="FitWidthButton_Click">Fit width</Button>
            <Button x:Name="FitPageButton" Click="FitPageButton_Click">Fit page</Button>
            <TextBox x:Name="SearchBox" Width="220" PlaceholderText="Find exact text" />
            <Button x:Name="SearchButton" Click="SearchButton_Click">Find</Button>
            <TextBlock x:Name="PrintStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16" ColumnDefinitions="*,260">
            <ProgressRing x:Name="BusyIndicator" Grid.ColumnSpan="2" IsActive="False" Visibility="Collapsed" />
            <StackPanel x:Name="EmptyState" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <Image Source="{ThemeResource AppMarkImageSource}" Width="96" Height="96" HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="EmptyStateMessage" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Text="Open a PDF to begin, or try the built-in sample." />
            </StackPanel>
            <TextBlock x:Name="ErrorState" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
            <ScrollViewer
                x:Name="PageScroller"
                Grid.Column="0"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed"
                ViewChanged="PageScroller_ViewChanged"
                SizeChanged="PageScroller_SizeChanged">
                <StackPanel x:Name="PageStack" HorizontalAlignment="Center" />
            </ScrollViewer>
            <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock x:Name="SearchStatus" TextWrapping="Wrap" />
                <ListView x:Name="SearchResultsList" SelectionChanged="SearchResultsList_SelectionChanged" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
