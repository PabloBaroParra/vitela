<Window
    x:Class="Pdf.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewer="using:Pdf.Windows.Viewer"
    Title="PDF">
    <!--
        KeyboardAcceleratorPlacementMode=Hidden because the paste, copy, find
        and new-document accelerators sit on the root Grid to catch
        Ctrl+V/Ctrl+C/Ctrl+F/Ctrl+N anywhere in the window, and Auto would
        advertise them as tooltips over that whole surface — a "Ctrl+V" label
        floating in the middle of the page. The property INHERITS, so the
        toolbar buttons whose shortcut tooltip is worth showing set Auto back
        locally; dropping that override silently mutes Ctrl+O, Ctrl+S,
        Ctrl+P, Ctrl+Z and Ctrl+Y too.
    -->
    <!--
        Background=Transparent so the window is hit-testable for drag and drop
        over its empty areas — a Panel with no brush is not, and dropping a PDF
        onto the empty state is the whole point. Same reason the page overlay
        Canvas carries one.
    -->
    <Grid Padding="20" RowSpacing="16" RowDefinitions="Auto,Auto,Auto,*" KeyboardAcceleratorPlacementMode="Hidden"
          Background="Transparent" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="PasteImage_Invoked" />
            <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="CopySelection_Invoked" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FindDocument_Invoked" />
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewDocument_Invoked" />
        </Grid.KeyboardAccelerators>
        <viewer:ToolbarPanel Grid.Row="0">
            <Button x:Name="OpenButton" Click="OpenButton_Click" KeyboardAcceleratorPlacementMode="Auto">
                Open
                <Button.KeyboardAccelerators><KeyboardAccelerator Key="O" Modifiers="Control" /></Button.KeyboardAccelerators>
            </Button>
            <Button x:Name="OpenSampleButton" Content="Open sample">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Vitela sample" Click="OpenSamplePlain_Click" />
                        <MenuFlyoutItem Text="AES-128 sample (user-aes-pass)" Click="OpenSampleAes128_Click" />
                        <MenuFlyoutItem Text="RC4-128 sample (user-rc4-pass)" Click="OpenSampleRc4128_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button x:Name="PrintButton" Click="PrintButton_Click" KeyboardAcceleratorPlacementMode="Auto">
                Print
                <Button.KeyboardAccelerators><KeyboardAccelerator Key="P" Modifiers="Control" /></Button.KeyboardAccelerators>
            </Button>
            <Button x:Name="SaveButton" Click="SaveButton_Click" KeyboardAcceleratorPlacementMode="Auto">
                Save
                <Button.KeyboardAccelerators><KeyboardAccelerator Key="S" Modifiers="Control" /></Button.KeyboardAccelerators>
            </Button>
            <Button x:Name="ProtectButton" Content="Protect" Click="ProtectButton_Click" />
            <Button x:Name="CompressButton" Content="Compress" Click="CompressButton_Click" />
            <Button x:Name="ExportImagesButton" Content="Export images" Click="ExportImagesButton_Click" ToolTipService.ToolTip="Save pages as PNG or JPEG files" />
            <Button x:Name="ExtractPagesButton" Content="Extract pages" Click="ExtractPagesButton_Click" ToolTipService.ToolTip="Save chosen pages as a new PDF" />
            <Button x:Name="SplitPagesButton" Content="Split PDF" Click="SplitPagesButton_Click" ToolTipService.ToolTip="Cut the document into several PDFs" />
            <ToggleButton x:Name="OrganizeButton" Content="Organize" Click="OrganizeButton_Click" ToolTipService.ToolTip="Move, rotate or delete pages" />
            <ToggleButton x:Name="PanelsButton" Content="Panels" IsChecked="True" Click="PanelsButton_Click" ToolTipService.ToolTip="Show or hide pages, properties, form fields and search results" />
            <TextBlock x:Name="DocumentTitle" VerticalAlignment="Center" Text="No document open" MaxWidth="200" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="PageCounter" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="ZoomOutButton" Click="ZoomOutButton_Click" ToolTipService.ToolTip="Zoom out">&#x2212;</Button>
                <TextBlock x:Name="ZoomLevel" VerticalAlignment="Center" MinWidth="110" />
                <Button x:Name="ZoomInButton" Click="ZoomInButton_Click" ToolTipService.ToolTip="Zoom in">&#x002B;</Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="FitWidthButton" Click="FitWidthButton_Click">Fit width</Button>
                <Button x:Name="FitPageButton" Click="FitPageButton_Click">Fit page</Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="UndoButton" Click="UndoButton_Click" KeyboardAcceleratorPlacementMode="Auto">
                    Undo
                    <Button.KeyboardAccelerators><KeyboardAccelerator Key="Z" Modifiers="Control" /></Button.KeyboardAccelerators>
                </Button>
                <Button x:Name="RedoButton" Click="RedoButton_Click" KeyboardAcceleratorPlacementMode="Auto">
                    Redo
                    <Button.KeyboardAccelerators><KeyboardAccelerator Key="Y" Modifiers="Control" /></Button.KeyboardAccelerators>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBox x:Name="SearchBox" Width="220" PlaceholderText="Find exact text" ToolTipService.ToolTip="Case-sensitive. Press Enter to search." KeyDown="SearchBox_KeyDown" />
                <Button x:Name="SearchButton" Click="SearchButton_Click">Find</Button>
            </StackPanel>
            <TextBlock x:Name="PrintStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
        </viewer:ToolbarPanel>

        <viewer:ToolbarPanel Grid.Row="1">
            <ToggleButton x:Name="HighlightButton" Click="HighlightButton_Click">Highlight</ToggleButton>
            <ToggleButton x:Name="UnderlineButton" Click="UnderlineButton_Click">Underline</ToggleButton>
            <ToggleButton x:Name="StrikeoutButton" Click="StrikeoutButton_Click">Strikeout</ToggleButton>
            <ToggleButton x:Name="ShapeButton" Click="ShapeButton_Click">Shape</ToggleButton>
            <ToggleButton x:Name="InkButton" Click="InkButton_Click">Ink</ToggleButton>
            <ToggleButton x:Name="NoteButton" Click="NoteButton_Click">Note</ToggleButton>
            <ToggleButton x:Name="StampButton" Click="StampButton_Click">Stamp</ToggleButton>
            <Button x:Name="PointerButton" Click="PointerButton_Click">Pointer</Button>
            <Button x:Name="PreviousAnnotationButton" Click="PreviousAnnotationButton_Click" ToolTipService.ToolTip="Select the previous annotation, including ones underneath others" IsEnabled="False">Previous annotation</Button>
            <Button x:Name="NextAnnotationButton" Click="NextAnnotationButton_Click" ToolTipService.ToolTip="Select the next annotation, including ones underneath others" IsEnabled="False">Next annotation</Button>
            <ToggleButton x:Name="ContentEditButton" Click="ContentEditButton_Click" ToolTipService.ToolTip="Click a text run on the page to retype it">Edit text</ToggleButton>
            <Button x:Name="ResizeImageButton" Content="Resize image" Click="ResizeImageButton_Click" IsEnabled="False" ToolTipService.ToolTip="Resize a content image on the visible page" />
            <Button x:Name="MoveImageButton" Content="Move image" Click="MoveImageButton_Click" IsEnabled="False" ToolTipService.ToolTip="Move a content image on the visible page" />
            <Button x:Name="DeleteImageButton" Content="Delete image" Click="DeleteImageButton_Click" IsEnabled="False" ToolTipService.ToolTip="Delete a content image on the visible page" />
            <Button x:Name="ReplaceImageButton" Content="Replace image" Click="ReplaceImageButton_Click" IsEnabled="False" ToolTipService.ToolTip="Replace a content image while keeping its position and size" />
            <Button x:Name="InsertImageButton" Content="Insert image" Click="InsertImageButton_Click" IsEnabled="False" ToolTipService.ToolTip="Add a content image to the visible page" />
            <Button x:Name="DeleteTextButton" Content="Delete text" Click="DeleteTextButton_Click" IsEnabled="False" ToolTipService.ToolTip="Delete a text run on the visible page" />
            <Button x:Name="MoveTextButton" Content="Move text" Click="MoveTextButton_Click" IsEnabled="False" ToolTipService.ToolTip="Move a text run on the visible page" />
            <Button x:Name="InsertTextButton" Content="Insert text" Click="InsertTextButton_Click" IsEnabled="False" ToolTipService.ToolTip="Add new text to the visible page" />
            <Button x:Name="NudgeButton" Click="NudgeButton_Click" ToolTipService.ToolTip="Shift the selected annotation">Nudge</Button>
            <Button x:Name="GrowButton" Click="GrowButton_Click" ToolTipService.ToolTip="Enlarge the selected annotation">Grow</Button>
            <Button x:Name="AnnotationColorButton" AutomationProperties.Name="Change selected annotation color" ToolTipService.ToolTip="Change selected annotation color">Color
                <Button.Flyout>
                    <Flyout x:Name="AnnotationColorFlyout" Closed="AnnotationColorFlyout_Closed">
                        <ColorPicker x:Name="AnnotationColorPicker" ColorChanged="AnnotationColorPicker_ColorChanged" IsAlphaEnabled="False" Orientation="Horizontal" />
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button x:Name="DeleteAnnotationButton" Click="DeleteAnnotationButton_Click" KeyboardAcceleratorPlacementMode="Auto">Delete
                <Button.KeyboardAccelerators><KeyboardAccelerator Key="Delete" Invoked="DeleteAnnotation_Invoked" /></Button.KeyboardAccelerators>
            </Button>
        </viewer:ToolbarPanel>

        <TextBlock x:Name="AnnotationStatus" Grid.Row="2" TextWrapping="Wrap" />

        <Grid x:Name="DocumentArea" Grid.Row="3" ColumnDefinitions="*,Auto,Auto" SizeChanged="DocumentArea_SizeChanged">
            <ProgressRing x:Name="BusyIndicator" Grid.ColumnSpan="3" IsActive="False" Visibility="Collapsed" />
            <StackPanel x:Name="EmptyState" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <Image Source="{ThemeResource AppMarkImageSource}" Width="96" Height="96" HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="EmptyStateMessage" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Text="Drop a PDF here to open it, or try the built-in sample." />
            </StackPanel>
            <TextBlock x:Name="ErrorState" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
            <ScrollViewer
                x:Name="PageScroller"
                Grid.Column="0"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed"
                ViewChanged="PageScroller_ViewChanged"
                SizeChanged="PageScroller_SizeChanged">
                <StackPanel x:Name="PageStack" HorizontalAlignment="Center" />
            </ScrollViewer>
            <!--
                Stands in for PageScroller while organizing. SelectionMode=None:
                a card is acted on through its own buttons or by dragging it,
                and a selection would only be a second, unused state.
            -->
            <Grid x:Name="OrganizePanel" Grid.Column="0" RowDefinitions="Auto,*" Visibility="Collapsed" RowSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="InsertBlankPageButton" Content="Add blank A4 page" Click="InsertBlankPageButton_Click" />
                    <Button x:Name="InsertLandscapePageButton" Content="Add landscape A4 page" Click="InsertLandscapePageButton_Click" />
                </StackPanel>
                <GridView
                    x:Name="OrganizeGrid"
                    Grid.Row="1"
                    SelectionMode="None"
                    CanDragItems="True"
                    CanReorderItems="True"
                    AllowDrop="True"
                    DragItemsStarting="OrganizeGrid_DragItemsStarting"
                    DragItemsCompleted="OrganizeGrid_DragItemsCompleted" />
            </Grid>
            <Thumb x:Name="SidebarDivider" Grid.Column="1" Width="16" Background="Transparent" IsTabStop="True" UseSystemFocusVisuals="True"
                   AutomationProperties.Name="Resize document panels"
                   ToolTipService.ToolTip="Drag to resize panels, or use Left and Right arrows when focused"
                   DragDelta="SidebarDivider_DragDelta" KeyDown="SidebarDivider_KeyDown">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="{TemplateBinding Background}">
                            <Border Width="2" HorizontalAlignment="Center" Background="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <ScrollViewer x:Name="DocumentSidebar" Grid.Column="2" Width="300"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          AutomationProperties.Name="Document panels">
                <StackPanel Spacing="8">
                    <Expander x:Name="PagesPanel" Header="Pages" IsExpanded="True">
                        <ListView x:Name="PageNavigationList" MaxHeight="180" MinWidth="220"
                                  SelectionMode="Single" IsEnabled="False"
                                  AutomationProperties.Name="Go to page"
                                  SelectionChanged="PageNavigationList_SelectionChanged" />
                    </Expander>
                    <Expander x:Name="DocumentProperties" Header="Document properties" IsExpanded="False">
                        <StackPanel Spacing="6" Padding="0,8,0,8">
                            <TextBlock x:Name="MetadataPermission" TextWrapping="Wrap" />
                            <TextBox x:Name="MetadataTitle" Header="Title" />
                            <TextBox x:Name="MetadataAuthor" Header="Author" />
                            <TextBox x:Name="MetadataSubject" Header="Subject" />
                            <TextBox x:Name="MetadataKeywords" Header="Keywords" />
                            <TextBox x:Name="MetadataCreator" Header="Creator" />
                            <TextBox x:Name="MetadataProducer" Header="Producer" />
                            <Button x:Name="ApplyMetadataButton" Content="Apply properties" Click="ApplyMetadataButton_Click" />
                        </StackPanel>
                    </Expander>
                    <Expander x:Name="FormFieldsPanel" Header="Form fields" IsExpanded="False">
                        <StackPanel Spacing="6" Padding="0,8,0,8">
                            <TextBlock x:Name="FormFieldsStatus" TextWrapping="Wrap" />
                            <ToggleButton x:Name="PlaceTextFieldButton" Content="Place text field" Click="PlaceTextFieldButton_Click" IsEnabled="False" />
                            <ToggleButton x:Name="PlaceCheckboxButton" Content="Place checkbox" Click="PlaceCheckboxButton_Click" IsEnabled="False" />
                            <ToggleButton x:Name="PlaceRadioGroupButton" Content="Place radio group" Click="PlaceRadioGroupButton_Click" IsEnabled="False" />
                            <ToggleButton x:Name="PlaceDropdownButton" Content="Place dropdown" Click="PlaceDropdownButton_Click" IsEnabled="False" />
                            <ScrollViewer x:Name="FormFieldsScroller" MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="FormFieldRows" Spacing="10" />
                            </ScrollViewer>
                        </StackPanel>
                    </Expander>
                    <TextBlock x:Name="SearchStatus" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PreviousMatchButton" Click="PreviousMatchButton_Click" IsEnabled="False">Previous match</Button>
                        <Button x:Name="NextMatchButton" Click="NextMatchButton_Click" IsEnabled="False">Next match</Button>
                    </StackPanel>
                    <ListView x:Name="SearchResultsList" MaxHeight="240" SelectionChanged="SearchResultsList_SelectionChanged" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
