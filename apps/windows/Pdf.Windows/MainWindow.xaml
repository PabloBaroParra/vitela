<Window
    x:Class="Pdf.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewer="using:Pdf.Windows.Viewer"
    xmlns:i18n="using:Pdf.Windows.Localization"
    Title="Vitela">
    <!--
        KeyboardAcceleratorPlacementMode=Hidden because shell accelerators
        sit on the root Grid to catch file, clipboard and find commands
        anywhere in the window, and Auto would
        advertise them as tooltips over that whole surface — a "Ctrl+V" label
        floating in the middle of the page. The property INHERITS, so the
        toolbar buttons with local accelerators set Auto back locally. Open,
        Save and Print instead state their shell-wide shortcuts in explicit tooltips.
    -->
    <!--
        Background=Transparent so the window is hit-testable for drag and drop
        over its empty areas — a Panel with no brush is not, and dropping a PDF
        onto the empty state is the whole point. Same reason the page overlay
        Canvas carries one.
    -->
    <Grid x:Name="ShellRoot" RowDefinitions="Auto,Auto,*,Auto" KeyboardAcceleratorPlacementMode="Hidden"
          Background="{ThemeResource VitelaWindowBackgroundBrush}" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop" Loaded="ShellRoot_Loaded">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="ShellOpen_Invoked" />
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="ShellSave_Invoked" />
            <KeyboardAccelerator Key="P" Modifiers="Control" Invoked="ShellPrint_Invoked" />
            <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="PasteImage_Invoked" />
            <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="CopySelection_Invoked" />
            <KeyboardAccelerator Key="X" Modifiers="Control" Invoked="CutContent_Invoked" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FindDocument_Invoked" />
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewDocument_Invoked" />
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="CommandPalette_Invoked" />
            <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="CloseTab_Invoked" />
            <KeyboardAccelerator Key="F4" Modifiers="Control" Invoked="CloseTab_Invoked" />
            <KeyboardAccelerator Key="Tab" Modifiers="Control" Invoked="NextTab_Invoked" />
            <KeyboardAccelerator Key="Tab" Modifiers="Control,Shift" Invoked="PreviousTab_Invoked" />
        </Grid.KeyboardAccelerators>
        <!--
            The mode bar (GTK mode_bar.rs): Home, Edit, Annotate, Organize, Sign
            and Protect as one row of tabs above the views. MainWindow.ModeBar.cs
            fills it and derives the checked tab from the screen; it stores none.
        -->
        <Border Grid.Row="0" Style="{StaticResource ModeBarStyle}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8" Padding="2" VerticalAlignment="Center">
                    <Image Source="{ThemeResource AppMarkImageSource}" Width="24" Height="24" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="Vitela" Style="{StaticResource BrandWordStyle}" />
                </StackPanel>
                <viewer:ToolbarPanel x:Name="ModeBar" Grid.Column="1" VerticalAlignment="Center"
                                     AutomationProperties.Name="{i18n:T Key=mode-bar-sections}" />
            </Grid>
        </Border>
        <!--
            HomeView is a UserControl only so the header can stay put while the
            body scrolls and the whole page still has one Visibility/IsEnabled
            owner for the navigation code. The body scrolls vertically only: a
            horizontally scrolling parent measures its children at infinite
            width, which collapsed the star columns and clipped the right column
            in the first Windows Home. HomeLayout reflows the columns instead.
        -->
        <!--
            Document tabs (GTK tabs/strip.rs): one per open document, above the
            editor and Organize screens, hidden on Home and with no document.
            MainWindow.TabStrip.cs fills it; MainWindow.Tabs.cs owns the tabs.
        -->
        <Border x:Name="TabStrip" Grid.Row="1" Visibility="Collapsed" Padding="8,4,8,0"
                Background="{ThemeResource VitelaSurfaceBrush}" BorderBrush="{ThemeResource VitelaStrongSeparatorBrush}" BorderThickness="0,0,0,1"
                AutomationProperties.Name="{i18n:T Key=tabs-strip}">
            <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="TabStripPanel" Orientation="Horizontal" Spacing="2" />
            </ScrollViewer>
        </Border>
        <UserControl x:Name="HomeView" Grid.Row="2" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid RowDefinitions="Auto,*" Background="{ThemeResource VitelaWindowBackgroundBrush}">
            <Border Style="{StaticResource HomeHeaderStyle}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBox x:Name="HomeSearchBox" PlaceholderText="{i18n:T Key=home-search-placeholder}" MaxWidth="340" VerticalAlignment="Center"
                             AutomationProperties.Name="{i18n:T Key=home-search-placeholder}" TextChanged="HomeSearchBox_TextChanged" />
                    <Button Grid.Column="1" Content="{i18n:T Key=home-open-file}" Style="{StaticResource HomePrimaryButtonStyle}" VerticalAlignment="Center"
                            Click="ShellOpen_Click" ToolTipService.ToolTip="{i18n:T Key=home-open-file-tooltip}" />
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                <Grid x:Name="HomeBody" Padding="24" ColumnSpacing="20" RowSpacing="0" RowDefinitions="Auto,Auto" ColumnDefinitions="*,268" SizeChanged="HomeBody_SizeChanged">
                    <StackPanel x:Name="HomeMainColumn" Spacing="20">
                        <Button x:Name="ReturnToDocumentButton" Content="{i18n:T Key=home-return-to-document}" Click="ReturnToDocument_Click" Visibility="Collapsed" Style="{StaticResource HomePrimaryButtonStyle}" HorizontalAlignment="Left" />
                        <StackPanel Spacing="6">
                            <TextBlock Text="{i18n:T Key=home-welcome-title}" Style="{StaticResource HomeHeroTitleStyle}" />
                            <TextBlock Text="{i18n:T Key=home-welcome-subtitle}" Style="{StaticResource HomeSubtitleStyle}" Margin="0,0,0,10" />
                            <TextBlock Text="{i18n:T Key=home-start-task}" Style="{StaticResource HomeSectionTitleStyle}" Margin="0,0,0,6" />
                            <Border x:Name="HomeDropZone" Background="{ThemeResource VitelaEditorBackgroundBrush}" CornerRadius="14"
                                    Tapped="HomeDropZone_Tapped" AllowDrop="True"
                                    DragOver="HomeDropZone_DragOver" DragLeave="HomeDropZone_DragLeave" Drop="HomeDropZone_Drop">
                                <Grid>
                                    <!-- .home-dropzone's 2px dashed border: a Border cannot dash, so the outline is a Rectangle. -->
                                    <Rectangle x:Name="HomeDropZoneOutline" RadiusX="13" RadiusY="13" StrokeThickness="2" StrokeDashArray="4 3"
                                               Stroke="{ThemeResource VitelaStrongSeparatorBrush}" IsHitTestVisible="False" />
                                    <StackPanel Spacing="10" Margin="28">
                                        <TextBlock Text="{i18n:T Key=home-drop-prompt}" TextAlignment="Center" Style="{StaticResource HomeSubtitleStyle}" />
                                        <TextBlock Text="{i18n:T Key=home-drop-hint}" TextAlignment="Center" Style="{StaticResource HomeMetaStyle}" />
                                        <Button x:Name="HomeSelectFileButton" Content="{i18n:T Key=home-select-file}" Style="{StaticResource HomePrimaryButtonStyle}"
                                                Click="ShellOpen_Click" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="10">
                            <TextBlock Text="{i18n:T Key=home-recent-title}" Style="{StaticResource HomeSectionTitleStyle}" />
                            <ItemsControl x:Name="RecentFilesList" AutomationProperties.Name="{i18n:T Key=home-recent-files}" IsTabStop="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Spacing="14" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock x:Name="RecentEmptyMessage" Text="{i18n:T Key=home-recent-empty}" Style="{StaticResource HomeSubtitleStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="HomeToolsColumn" Grid.Column="1" Spacing="16" VerticalAlignment="Top" />
                </Grid>
                <!-- .home-version: which build is running (Viewer/AppVersion.cs); scrolls with the body. -->
                <TextBlock x:Name="HomeVersionText" Style="{StaticResource HomeMetaStyle}" HorizontalAlignment="Right"
                           Margin="24,0,24,16" IsTextSelectionEnabled="True" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </UserControl>
        <Grid x:Name="EditorView" Grid.Row="2" RowSpacing="0" Style="{StaticResource EditorMainStyle}" RowDefinitions="Auto,Auto,*" Visibility="Collapsed">
        <Border Grid.Row="0" Style="{StaticResource EditorToolbarStyle}">
        <!--
            BuildEditorToolbar (MainWindow.Toolbar.cs) gives every button here
            its icon, caption, accessible name and tooltip, and regroups them;
            only text it does not set is declared below.
        -->
        <viewer:ToolbarPanel x:Name="EditorToolbar">
            <Button x:Name="OpenButton" Click="OpenButton_Click" />
            <Button x:Name="OpenSampleButton">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="{i18n:T Key=editor-sample-plain}" Click="OpenSamplePlain_Click" />
                        <MenuFlyoutItem Text="{i18n:T Key=editor-sample-aes128}" Click="OpenSampleAes128_Click" />
                        <MenuFlyoutItem Text="{i18n:T Key=editor-sample-rc4128}" Click="OpenSampleRc4128_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button x:Name="PrintButton" Click="PrintButton_Click" />
            <Button x:Name="ShareButton" Click="ShareButton_Click" />
            <Button x:Name="SaveButton" Click="SaveButton_Click" />
            <Button x:Name="ProtectButton" Click="ProtectButton_Click" />
            <Button x:Name="CompressButton" Click="CompressButton_Click" />
            <Button x:Name="ExportImagesButton" Click="ExportImagesButton_Click" />
            <Button x:Name="ExtractPagesButton" Click="ExtractPagesButton_Click" />
            <Button x:Name="SplitPagesButton" Click="SplitPagesButton_Click" />
            <ToggleButton x:Name="OrganizeButton" Click="OrganizeButton_Click" />
            <ToggleButton x:Name="PagesPanelButton" IsChecked="True" Click="PagesPanelButton_Click" />
            <ToggleButton x:Name="ToolsPanelButton" IsChecked="True" Click="ToolsPanelButton_Click" />
            <TextBlock x:Name="DocumentTitle" VerticalAlignment="Center" Text="{i18n:T Key=editor-no-document}" MaxWidth="200" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="PageCounter" VerticalAlignment="Center" MinWidth="54" TextAlignment="Center" />
            <Button x:Name="FirstPageButton" Click="FirstPageButton_Click" IsEnabled="False" KeyboardAcceleratorPlacementMode="Auto">
                <Button.KeyboardAccelerators><KeyboardAccelerator Key="Home" Modifiers="Control" /></Button.KeyboardAccelerators>
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="PreviousPageButton" Click="PreviousPageButton_Click" IsEnabled="False" KeyboardAcceleratorPlacementMode="Auto">
                    <Button.KeyboardAccelerators><KeyboardAccelerator Key="Up" Modifiers="Control" /></Button.KeyboardAccelerators>
                </Button>
                <Button x:Name="NextPageButton" Click="NextPageButton_Click" IsEnabled="False" KeyboardAcceleratorPlacementMode="Auto">
                    <Button.KeyboardAccelerators><KeyboardAccelerator Key="Down" Modifiers="Control" /></Button.KeyboardAccelerators>
                </Button>
            </StackPanel>
            <Button x:Name="LastPageButton" Click="LastPageButton_Click" IsEnabled="False" KeyboardAcceleratorPlacementMode="Auto">
                <Button.KeyboardAccelerators><KeyboardAccelerator Key="End" Modifiers="Control" /></Button.KeyboardAccelerators>
            </Button>
            <Button x:Name="GoToPageButton" Click="GoToPageButton_Click" IsEnabled="False" KeyboardAcceleratorPlacementMode="Auto">
                <Button.KeyboardAccelerators><KeyboardAccelerator Key="G" Modifiers="Control" /></Button.KeyboardAccelerators>
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="ZoomOutButton" Click="ZoomOutButton_Click" />
                <TextBlock x:Name="ZoomLevel" VerticalAlignment="Center" MinWidth="48" TextAlignment="Center" />
                <Button x:Name="ZoomInButton" Click="ZoomInButton_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="FitWidthButton" Click="FitWidthButton_Click" />
                <Button x:Name="FitPageButton" Click="FitPageButton_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="UndoButton" Click="UndoButton_Click" KeyboardAcceleratorPlacementMode="Auto">
                    <Button.KeyboardAccelerators><KeyboardAccelerator Key="Z" Modifiers="Control" /></Button.KeyboardAccelerators>
                </Button>
                <Button x:Name="RedoButton" Click="RedoButton_Click" KeyboardAcceleratorPlacementMode="Auto">
                    <Button.KeyboardAccelerators><KeyboardAccelerator Key="Y" Modifiers="Control" /></Button.KeyboardAccelerators>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBox x:Name="SearchBox" Width="220" ToolTipService.ToolTip="{i18n:T Key=editor-find-hint}" KeyDown="SearchBox_KeyDown" />
                <Button x:Name="SearchButton" Content="{i18n:T Key=editor-find-submit}" Click="SearchButton_Click" />
            </StackPanel>
        </viewer:ToolbarPanel>
        </Border>

        <viewer:ToolbarPanel x:Name="EditingToolbar" Grid.Row="1">
            <ToggleButton x:Name="HighlightButton" Click="HighlightButton_Click" Content="{i18n:T Key=annotate-tool-highlight}" />
            <ToggleButton x:Name="UnderlineButton" Click="UnderlineButton_Click" Content="{i18n:T Key=annotate-tool-underline}" />
            <ToggleButton x:Name="StrikeoutButton" Click="StrikeoutButton_Click" Content="{i18n:T Key=annotate-tool-strikeout}" />
            <ToggleButton x:Name="ShapeButton" Click="ShapeButton_Click" Content="{i18n:T Key=annotate-tool-shape}" />
            <ToggleButton x:Name="InkButton" Click="InkButton_Click" Content="{i18n:T Key=annotate-tool-ink}" />
            <ToggleButton x:Name="NoteButton" Click="NoteButton_Click" Content="{i18n:T Key=annotate-tool-note}" />
            <ToggleButton x:Name="FreeTextButton" Click="FreeTextButton_Click" ToolTipService.ToolTip="{i18n:T Key=annotate-text-box-tooltip}" Content="{i18n:T Key=annotate-tool-text-box}" />
            <ToggleButton x:Name="StampButton" Click="StampButton_Click" Content="{i18n:T Key=annotate-tool-stamp}" />
            <Button x:Name="PointerButton" Click="PointerButton_Click" Content="{i18n:T Key=annotate-pointer}" />
            <Button x:Name="PreviousAnnotationButton" Click="PreviousAnnotationButton_Click" ToolTipService.ToolTip="{i18n:T Key=annotate-previous-tooltip}" IsEnabled="False" Content="{i18n:T Key=annotate-previous}" />
            <Button x:Name="NextAnnotationButton" Click="NextAnnotationButton_Click" ToolTipService.ToolTip="{i18n:T Key=annotate-next-tooltip}" IsEnabled="False" Content="{i18n:T Key=annotate-next}" />
            <Button x:Name="EditFreeTextButton" Click="EditFreeTextButton_Click" ToolTipService.ToolTip="{i18n:T Key=annotate-edit-text-box-tooltip}" IsEnabled="False" Content="{i18n:T Key=annotate-edit-text-box}" />
            <Button x:Name="ReadNoteButton" Click="ReadNoteButton_Click" ToolTipService.ToolTip="{i18n:T Key=annotate-read-note-tooltip}" IsEnabled="False" Content="{i18n:T Key=annotate-read-note}" />
            <ToggleButton x:Name="ContentEditButton" Click="ContentEditButton_Click" Content="{i18n:T Key=edit-mode}" />
            <Button x:Name="ResizeImageButton" Content="{i18n:T Key=edit-resize-image}" Click="ResizeImageButton_Click" IsEnabled="False" ToolTipService.ToolTip="{i18n:T Key=edit-resize-image-tooltip}" />
            <Button x:Name="MoveImageButton" Content="{i18n:T Key=edit-move-image}" Click="MoveImageButton_Click" IsEnabled="False" ToolTipService.ToolTip="{i18n:T Key=edit-move-image-tooltip}" />
            <Button x:Name="DeleteImageButton" Content="{i18n:T Key=edit-delete-image}" Click="DeleteImageButton_Click" IsEnabled="False" ToolTipService.ToolTip="{i18n:T Key=edit-delete-image-tooltip}" />
            <Button x:Name="ReplaceImageButton" Content="{i18n:T Key=edit-replace-image}" Click="ReplaceImageButton_Click" IsEnabled="False" ToolTipService.ToolTip="{i18n:T Key=edit-replace-image-tooltip}" />
            <ToggleButton x:Name="InsertImageButton" Content="{i18n:T Key=edit-insert-image}" Click="InsertImageButton_Click" IsEnabled="False" ToolTipService.ToolTip="{i18n:T Key=edit-insert-image-tooltip}" />
            <Button x:Name="DeleteTextButton" Content="{i18n:T Key=edit-delete-text}" Click="DeleteTextButton_Click" IsEnabled="False" ToolTipService.ToolTip="{i18n:T Key=edit-delete-text-run-tooltip}" />
            <Button x:Name="MoveTextButton" Content="{i18n:T Key=edit-move-text}" Click="MoveTextButton_Click" IsEnabled="False" ToolTipService.ToolTip="{i18n:T Key=edit-move-text-tooltip}" />
            <ToggleButton x:Name="InsertTextButton" Content="{i18n:T Key=edit-insert-text}" Click="InsertTextButton_Click" IsEnabled="False" ToolTipService.ToolTip="{i18n:T Key=edit-insert-text-tooltip}" />
            <Button x:Name="AddWatermarkButton" Content="{i18n:T Key=edit-watermark}" Click="AddWatermarkButton_Click" IsEnabled="False" ToolTipService.ToolTip="{i18n:T Key=edit-watermark-picture-tooltip}" />
            <Button x:Name="NudgeButton" Click="NudgeButton_Click" ToolTipService.ToolTip="{i18n:T Key=annotate-nudge-tooltip}" Content="{i18n:T Key=annotate-nudge}" />
            <Button x:Name="MoveAnnotationButton" Click="MoveAnnotationButton_Click" ToolTipService.ToolTip="{i18n:T Key=annotate-move-tooltip}" IsEnabled="False" Content="{i18n:T Key=annotate-move}" />
            <Button x:Name="GrowButton" Click="GrowButton_Click" ToolTipService.ToolTip="{i18n:T Key=annotate-grow-tooltip}" Content="{i18n:T Key=annotate-grow}" />
            <Button x:Name="ResizeAnnotationButton" Click="ResizeAnnotationButton_Click" ToolTipService.ToolTip="{i18n:T Key=annotate-resize-tooltip}" IsEnabled="False" Content="{i18n:T Key=annotate-resize}" />
            <Button x:Name="AnnotationColorButton" AutomationProperties.Name="{i18n:T Key=annotate-restyle}" ToolTipService.ToolTip="{i18n:T Key=annotate-color-title}" Click="AnnotationColorButton_Click" Content="{i18n:T Key=annotate-restyle}" />
            <Button x:Name="DeleteAnnotationButton" Click="DeleteAnnotationButton_Click" KeyboardAcceleratorPlacementMode="Auto" Content="{i18n:T Key=annotate-delete}">
                <Button.KeyboardAccelerators><KeyboardAccelerator Key="Delete" Invoked="DeleteAnnotation_Invoked" /></Button.KeyboardAccelerators>
            </Button>
        </viewer:ToolbarPanel>

        <Grid x:Name="DocumentArea" Grid.Row="2" Padding="16" ColumnDefinitions="Auto,Auto,*,Auto,Auto" SizeChanged="DocumentArea_SizeChanged">
            <Grid x:Name="PagesSidebar" Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="8" Width="160" Padding="8" Background="{ThemeResource VitelaSurfaceBrush}" CornerRadius="8"
                  AutomationProperties.Name="{i18n:T Key=editor-pages}">
                <TextBlock Text="{i18n:T Key=editor-pages}" FontWeight="SemiBold" />
                <ListView x:Name="PageNavigationList" Grid.Row="1"
                          SelectionMode="Single" IsEnabled="False"
                          AutomationProperties.Name="{i18n:T Key=editor-go-to-page}"
                          SelectionChanged="PageNavigationList_SelectionChanged" />
            </Grid>
            <Thumb x:Name="PagesDivider" Grid.Column="1" Style="{StaticResource SideColumnDividerStyle}"
                   AutomationProperties.Name="{i18n:T Key=editor-resize-pages}"
                   ToolTipService.ToolTip="{i18n:T Key=editor-resize-pages-tooltip}"
                   DragStarted="PagesDivider_DragStarted" DragDelta="PagesDivider_DragDelta" KeyDown="PagesDivider_KeyDown" />
            <ProgressRing x:Name="BusyIndicator" Grid.Column="2" IsActive="False" Visibility="Collapsed" />
            <StackPanel x:Name="EmptyState" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <Image Source="{ThemeResource AppMarkImageSource}" Width="96" Height="96" HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="EmptyStateMessage" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Text="{i18n:T Key=editor-empty-state}" />
            </StackPanel>
            <TextBlock x:Name="ErrorState" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
            <ScrollViewer
                x:Name="PageScroller"
                Grid.Column="2"
                Background="{ThemeResource VitelaCanvasBackgroundBrush}"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                ZoomMode="Disabled"
                Visibility="Collapsed"
                ViewChanged="PageScroller_ViewChanged"
                SizeChanged="PageScroller_SizeChanged">
                <StackPanel x:Name="PageStack" HorizontalAlignment="Center" />
            </ScrollViewer>
            <!--
                Edit content's floating quick actions, over the page view and
                placed by MainWindow.QuickActions.cs. The canvas has no
                background, so it takes no pointer input of its own.
            -->
            <Canvas x:Name="QuickActionsLayer" Grid.Column="2" SizeChanged="QuickActionsLayer_SizeChanged">
                <Border x:Name="QuickActionsBar" Visibility="Collapsed" Background="{ThemeResource VitelaSurfaceBrush}"
                        BorderBrush="{ThemeResource VitelaHairlineBrush}" BorderThickness="1" CornerRadius="10" Padding="3"
                        AutomationProperties.Name="Quick actions">
                    <StackPanel x:Name="QuickActionsButtons" Orientation="Horizontal" Spacing="2" />
                </Border>
            </Canvas>
            <!--
                Stands in for PageScroller while organizing. SelectionMode=None:
                a card is acted on through its own buttons or by dragging it,
                and a selection would only be a second, unused state.
            -->
            <Thumb x:Name="ToolsDivider" Grid.Column="3" Style="{StaticResource SideColumnDividerStyle}"
                   AutomationProperties.Name="{i18n:T Key=editor-resize-tools}"
                   ToolTipService.ToolTip="{i18n:T Key=editor-resize-tools-tooltip}"
                   DragStarted="ToolsDivider_DragStarted" DragDelta="ToolsDivider_DragDelta" KeyDown="ToolsDivider_KeyDown" />
            <ScrollViewer x:Name="DocumentSidebar" Grid.Column="4" Width="300" Padding="12" Background="{ThemeResource VitelaSurfaceBrush}" CornerRadius="8"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          AutomationProperties.Name="{i18n:T Key=editor-document-panels}">
                <StackPanel x:Name="SidebarContent" Spacing="8">
                    <StackPanel x:Name="DocumentProperties" Spacing="6">
                        <TextBlock Text="{i18n:T Key=metadata-heading}" FontWeight="SemiBold" />
                        <StackPanel Spacing="6" Padding="0,8,0,8">
                            <TextBlock x:Name="MetadataPermission" TextWrapping="Wrap" />
                            <TextBlock x:Name="MetadataPages" Text="{i18n:T Key=metadata-pages-none}" />
                            <TextBox x:Name="MetadataTitle" Header="{i18n:T Key=metadata-title}" Tag="Title" IsEnabled="False" TextChanged="MetadataText_TextChanged" />
                            <TextBox x:Name="MetadataAuthor" Header="{i18n:T Key=metadata-author}" Tag="Author" IsEnabled="False" TextChanged="MetadataText_TextChanged" />
                            <TextBox x:Name="MetadataSubject" Header="{i18n:T Key=metadata-subject}" Tag="Subject" IsEnabled="False" TextChanged="MetadataText_TextChanged" />
                            <TextBox x:Name="MetadataKeywords" Header="{i18n:T Key=metadata-keywords}" Tag="Keywords" IsEnabled="False" TextChanged="MetadataText_TextChanged" />
                            <TextBox x:Name="MetadataCreator" Header="{i18n:T Key=metadata-creator}" Tag="Creator" IsEnabled="False" TextChanged="MetadataText_TextChanged" />
                            <TextBox x:Name="MetadataProducer" Header="{i18n:T Key=metadata-producer}" Tag="Producer" IsEnabled="False" TextChanged="MetadataText_TextChanged" />
                            <TextBox x:Name="MetadataCreated" Header="{i18n:T Key=metadata-created}" Tag="Created" IsEnabled="False" PlaceholderText="{i18n:T Key=metadata-date-placeholder}" KeyDown="MetadataDate_KeyDown" LostFocus="MetadataDate_LostFocus" />
                            <TextBox x:Name="MetadataModified" Header="{i18n:T Key=metadata-modified}" Tag="Modified" IsEnabled="False" PlaceholderText="{i18n:T Key=metadata-date-placeholder}" KeyDown="MetadataDate_KeyDown" LostFocus="MetadataDate_LostFocus" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="FormFieldsPanel" Spacing="10">
                        <StackPanel Spacing="6" Padding="0,8,0,8">
                            <TextBlock Text="{i18n:T Key=forms-heading-fields}" FontWeight="SemiBold" />
                            <viewer:ToolbarPanel>
                                <ToggleButton x:Name="EditFormsButton" Content="{i18n:T Key=forms-edit-mode}" Click="EditFormsButton_Click" IsEnabled="False" />
                                <ToggleButton x:Name="PlaceTextFieldButton" Content="{i18n:T Key=forms-kind-text}" Click="PlaceTextFieldButton_Click" IsEnabled="False" />
                                <ToggleButton x:Name="PlaceCheckboxButton" Content="{i18n:T Key=forms-kind-checkbox}" Click="PlaceCheckboxButton_Click" IsEnabled="False" />
                                <ToggleButton x:Name="PlaceRadioGroupButton" Content="{i18n:T Key=forms-kind-radio-group}" Click="PlaceRadioGroupButton_Click" IsEnabled="False" />
                                <ToggleButton x:Name="PlaceDropdownButton" Content="{i18n:T Key=forms-kind-dropdown}" Click="PlaceDropdownButton_Click" IsEnabled="False" />
                            </viewer:ToolbarPanel>
                            <TextBlock Text="{i18n:T Key=forms-heading-style}" FontWeight="SemiBold" />
                            <viewer:ToolbarPanel>
                                <ComboBox x:Name="FormStyleFont" Header="{i18n:T Key=forms-style-font}" Width="145" IsEnabled="False" SelectionChanged="FormStyleFont_SelectionChanged">
                                    <x:String>Helvetica</x:String><x:String>Times Roman</x:String><x:String>Courier</x:String>
                                </ComboBox>
                                <NumberBox x:Name="FormStyleSize" Header="{i18n:T Key=forms-style-size}" Width="110" Minimum="4" Maximum="400" SmallChange="1" LargeChange="10" Value="12" IsEnabled="False" SpinButtonPlacementMode="Compact" ValueChanged="FormStyleSize_ValueChanged" />
                                <Button x:Name="FormStyleColor" Content="{i18n:T Key=forms-color}" IsEnabled="False" Click="FormStyleColor_Click" />
                                <Button x:Name="DeleteFormFieldButton" Content="{i18n:T Key=forms-delete-field}" IsEnabled="False" Click="DeleteFormFieldButton_Click" ToolTipService.ToolTip="{i18n:T Key=forms-delete-field-tooltip}">
                                    <Button.KeyboardAccelerators><KeyboardAccelerator Key="Delete" Invoked="DeleteFormField_Invoked" /></Button.KeyboardAccelerators>
                                </Button>
                            </viewer:ToolbarPanel>
                            <TextBlock Text="{i18n:T Key=forms-heading-fill}" FontWeight="SemiBold" />
                            <TextBlock x:Name="FormFieldsStatus" Text="{i18n:T Key=forms-fill-placeholder}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ScrollViewer x:Name="FormFieldsScroller" MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="FormFieldRows" Spacing="10" />
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="SearchMatchControls" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PreviousMatchButton" Click="PreviousMatchButton_Click" IsEnabled="False" />
                        <Button x:Name="NextMatchButton" Click="NextMatchButton_Click" IsEnabled="False" />
                    </StackPanel>
                    <ListView x:Name="SearchResultsList" MaxHeight="240" SelectionChanged="SearchResultsList_SelectionChanged" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </Grid>
        <Grid x:Name="OrganizePanel" Grid.Row="2" Padding="16" Style="{StaticResource EditorMainStyle}" RowDefinitions="Auto,Auto,Auto,Auto,*"
              Visibility="Collapsed" RowSpacing="12" Loaded="OrganizePanel_Loaded">
            <StackPanel Spacing="12">
                <TextBlock x:Name="OrganizeHeading" Text="{i18n:T Key=organize-heading}" Style="{StaticResource OrganizeHeadingStyle}" />
                <viewer:ToolbarPanel>
                    <Button x:Name="OrganizeUndoButton" Content="{i18n:T Key=organize-undo}" Click="OrganizeUndoButton_Click" IsEnabled="False">
                        <Button.KeyboardAccelerators><KeyboardAccelerator Key="Z" Modifiers="Control" /></Button.KeyboardAccelerators>
                    </Button>
                    <Button x:Name="OrganizeRedoButton" Content="{i18n:T Key=organize-redo}" Click="OrganizeRedoButton_Click" IsEnabled="False">
                        <Button.KeyboardAccelerators><KeyboardAccelerator Key="Y" Modifiers="Control" /></Button.KeyboardAccelerators>
                    </Button>
                    <Button x:Name="OrganizeAddPdfsButton" Content="{i18n:T Key=organize-add-pdfs}" IsEnabled="False" Click="OrganizeAddPdfsButton_Click"
                            ToolTipService.ToolTip="{i18n:T Key=organize-add-pdfs-tooltip}" />
                    <Button x:Name="OrganizeExtractButton" Content="{i18n:T Key=organize-extract}" Click="ExtractPagesButton_Click" IsEnabled="False" ToolTipService.ToolTip="{i18n:T Key=organize-extract-tooltip}" />
                    <Button x:Name="OrganizeSplitButton" Content="{i18n:T Key=organize-split}" Click="SplitPagesButton_Click" IsEnabled="False" ToolTipService.ToolTip="{i18n:T Key=organize-split-tooltip}" />
                    <Button x:Name="OrganizeSaveButton" Content="{i18n:T Key=organize-save}" Click="SaveButton_Click" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
                </viewer:ToolbarPanel>
            </StackPanel>
            <StackPanel x:Name="ImportProgressPanel" Grid.Row="1" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                <ProgressBar x:Name="ImportProgressBar" Width="240" VerticalAlignment="Center" AutomationProperties.Name="{i18n:T Key=organize-import-progress-name}" />
                <TextBlock x:Name="ImportProgressText" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="CancelImportButton" Content="{i18n:T Key=organize-cancel-import-button}" Click="CancelImportButton_Click" />
            </StackPanel>
            <viewer:ToolbarPanel Grid.Row="2">
                <Button x:Name="InsertBlankPageButton" Content="{i18n:T Key=organize-add-blank-page}" Click="InsertBlankPageButton_Click" />
                <Button x:Name="InsertLandscapePageButton" Content="{i18n:T Key=organize-add-landscape-page}" Click="InsertLandscapePageButton_Click" />
                <Button x:Name="RotateAllLeftButton" Content="{i18n:T Key=organize-rotate-all-left}" Click="RotateAllLeftButton_Click"
                        ToolTipService.ToolTip="{i18n:T Key=organize-rotate-all-left-tooltip}" />
                <Button x:Name="RotateAllRightButton" Content="{i18n:T Key=organize-rotate-all-right}" Click="RotateAllRightButton_Click"
                        ToolTipService.ToolTip="{i18n:T Key=organize-rotate-all-right-tooltip}" />
                <Button x:Name="OrganizeReturnButton" Content="{i18n:T Key=organize-return}" Click="OrganizeReturnButton_Click" />
            </viewer:ToolbarPanel>
            <StackPanel Grid.Row="3" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ToggleButton x:Name="OrganizeDocumentsToggle" Style="{StaticResource OrganizeSwitchToggleStyle}" Content="{i18n:T Key=organize-view-documents}" IsChecked="True" Click="OrganizeDocumentsToggle_Click" />
                    <ToggleButton x:Name="OrganizePagesToggle" Style="{StaticResource OrganizeSwitchToggleStyle}" Content="{i18n:T Key=organize-view-pages}" Click="OrganizePagesToggle_Click" />
                </StackPanel>
                <TextBlock x:Name="OrganizeViewHint" Text="{i18n:T Key=organize-documents-hint}" Style="{StaticResource OrganizeHintStyle}" />
            </StackPanel>
            <ScrollViewer x:Name="OrganizeDocumentsScroller" Grid.Row="4" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="OrganizeDocumentsList" />
            </ScrollViewer>
            <GridView x:Name="OrganizeGrid" Grid.Row="4" Visibility="Collapsed" SelectionMode="None" CanDragItems="True" CanReorderItems="True" AllowDrop="True"
                      DragOver="OrganizeGrid_DragOver" DragItemsStarting="OrganizeGrid_DragItemsStarting" DragItemsCompleted="OrganizeGrid_DragItemsCompleted" />
        </Grid>
        <Border Grid.Row="3" Style="{StaticResource StatusBarStyle}"
                AutomationProperties.Name="{i18n:T Key=editor-status-bar}">
            <StackPanel Spacing="4">
                <TextBlock x:Name="AnnotationStatus" Style="{StaticResource StatusTextStyle}" Text="{i18n:T Key=editor-idle-status}"
                           TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"
                           ToolTipService.ToolTip="{Binding Text, ElementName=AnnotationStatus}" />
                <TextBlock x:Name="PrintStatus" Style="{StaticResource StatusTextStyle}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"
                            ToolTipService.ToolTip="{Binding Text, ElementName=PrintStatus}" />
                <TextBlock x:Name="SearchStatus" Style="{StaticResource StatusTextStyle}" Visibility="Collapsed" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"
                           ToolTipService.ToolTip="{Binding Text, ElementName=SearchStatus}" />
            </StackPanel>
        </Border>
        <!--
            Command palette (Ctrl+K), B27: a layer over the whole window, not a
            second window, so focus never crosses windows. The scrim takes any
            click outside the card and closes the palette; the card keeps Tab
            inside it. Behaviour lives in MainWindow.Palette.cs.
        -->
        <Grid x:Name="PaletteLayer" Grid.RowSpan="4" Visibility="Collapsed"
              ProcessKeyboardAccelerators="PaletteLayer_ProcessKeyboardAccelerators">
            <Rectangle x:Name="PaletteScrim" Fill="{ThemeResource VitelaWindowBackgroundBrush}" Opacity="0.55"
                       PointerPressed="PaletteScrim_PointerPressed" />
            <Border x:Name="PaletteCard" VerticalAlignment="Top" HorizontalAlignment="Stretch" MaxWidth="560" Margin="16,56,16,16" Padding="8"
                    Background="{ThemeResource VitelaSurfaceBrush}" BorderBrush="{ThemeResource VitelaStrongSeparatorBrush}" BorderThickness="1" CornerRadius="10"
                    TabFocusNavigation="Cycle" PreviewKeyDown="PaletteCard_PreviewKeyDown" AutomationProperties.Name="Command palette">
                <StackPanel Spacing="6">
                    <TextBox x:Name="PaletteSearchBox" PlaceholderText="Search commands…" AutomationProperties.Name="Search commands"
                             TextChanged="PaletteSearchBox_TextChanged" />
                    <ListView x:Name="PaletteList" MaxHeight="380" SelectionMode="Single" IsItemClickEnabled="True"
                              ItemClick="PaletteList_ItemClick" AutomationProperties.Name="Commands" />
                    <TextBlock x:Name="PaletteEmpty" Text="No command matches." Visibility="Collapsed" Margin="12"
                               Foreground="{ThemeResource VitelaTextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
