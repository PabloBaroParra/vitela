    <!-- Annotation size and position -->
    <string name="annotation_resize_title">Cambiar tamaño de la anotación — página %1$s</string>
    <string name="annotation_resize_help">La anotación mantiene su esquina inferior izquierda. El ancho y el alto son independientes; los sellos se estiran para ajustarse.</string>
    <string name="annotation_move_title">Mover anotación — página %1$s</string>
    <string name="annotation_move_help">Indica la esquina inferior izquierda de la anotación en el espacio PDF sin girar. X aumenta hacia la derecha; Y aumenta hacia arriba. El tamaño no cambia.</string>

    <!-- Edit content: the help names the buttons, so it uses their words -->
    <string name="content_text_title">Editar texto</string>
    <string name="content_text_retype">Reescribir</string>
    <string name="content_text_font_substituted">La fuente de este texto no se puede conservar. Lo que escribas usará una fuente estándar.</string>
    <string name="content_text_help_paragraph">Cada salto de línea que escribas empieza una línea nueva; el texto se ajusta al ancho del párrafo.</string>
    <string name="content_text_help_move">Mover te permite arrastrar este texto o tocar donde deba ir, conservando su fuente y su tamaño.</string>
    <string name="content_text_help_save">Para mover una línea que ya has reescrito, o reescribir una que ya has movido, hay que guardar antes.</string>
    <string name="content_text_help_delete">Eliminar lo quita de la página; Deshacer lo recupera. No es una censura segura.</string>
    <string name="content_image_title">Editar imagen</string>
    <string name="content_image_replace">Reemplazar</string>
    <string name="content_image_help">La imagen mantiene su esquina superior izquierda y se estira hasta el tamaño que indiques. Mover te permite arrastrarla o tocar donde deba ir, conservando su tamaño. Reemplazar la cambia por un PNG o JPEG, estirado hasta el mismo recuadro; guarda primero si la imagen ya tiene un cambio pendiente. Eliminar la quita de la página; Deshacer la recupera.</string>
    <string name="content_shape_title">Editar forma</string>
    <string name="content_shape_help">La forma mantiene su esquina superior izquierda y su grosor de línea, y se estira hasta el tamaño que indiques; el texto de su interior no se toca. Una línea no tiene alto que cambiar. Mover te permite arrastrarla o tocar donde deba ir, conservando su tamaño. Eliminar la quita de la página; Deshacer la recupera.</string>
    <string name="content_insert_title">Añadir texto — página %1$s</string>
    <string name="content_insert_help">Añade una línea de texto en Helvetica al contenido de la página, con su esquina superior izquierda donde has tocado. Algunos caracteres no se pueden mostrar con esta fuente.</string>
    <string name="content_insert">Insertar</string>

