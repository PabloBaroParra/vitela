    <!-- Compress -->
    <string name="compress_title">Comprimir PDF</string>
    <string name="compress_detail">Guarda una copia más pequeña. El documento abierto se queda como está.</string>
    <string name="compress_lossless">Sin pérdida</string>
    <string name="compress_lossless_detail">Solo reorganiza el archivo. Todas las páginas se ven exactamente igual que ahora.</string>
    <string name="compress_balanced">Equilibrado</string>
    <string name="compress_balanced_detail">Además, reduce las imágenes a 150 DPI. En pantalla no se aprecia la diferencia y en el disco ocupa bastante menos.</string>
    <string name="compress_small">Pequeño</string>
    <string name="compress_small_detail">Además, reduce las imágenes a 96 DPI. Para cuando el archivo tiene que caber en algún sitio y los píxeles importan menos que eso.</string>
