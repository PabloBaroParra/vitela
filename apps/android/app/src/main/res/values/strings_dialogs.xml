    <!-- Edit content: the help names the buttons, so it uses their words -->
    <string name="content_text_title">Edit text</string>
    <string name="content_text_retype">Retype</string>
    <string name="content_text_font_substituted">This text\'s font cannot be kept. What you type will use a standard font.</string>
    <string name="content_text_help_paragraph">Each line break you type starts a new line; the text wraps to the paragraph\'s width.</string>
    <string name="content_text_help_move">Move lets you drag this text, or tap where it should go, keeping its font and size.</string>
    <string name="content_text_help_save">Moving a line you already retyped, or retyping one you already moved, needs a save first.</string>
    <string name="content_text_help_delete">Delete takes it off the page; Undo puts it back. It is not a secure redaction.</string>
    <string name="content_image_title">Edit image</string>
    <string name="content_image_replace">Replace</string>
    <string name="content_image_help">The image keeps its top-left corner and is stretched to the size you enter. Move lets you drag it, or tap where it should go, keeping its size. Replace swaps its picture for a PNG or JPEG, stretched to the same box; save first if the image already has a pending edit. Delete takes it off the page; Undo puts it back.</string>
    <string name="content_shape_title">Edit shape</string>
    <string name="content_shape_help">The shape keeps its top-left corner and its line width, and is stretched to the size you enter; the text inside it is not touched. A line has no height to change. Move lets you drag it, or tap where it should go, keeping its size. Delete takes it off the page; Undo puts it back.</string>
    <string name="content_insert_title">Add text — page %1$s</string>
    <string name="content_insert_help">Adds one line of Helvetica text as page content, its top-left corner where you tapped. Some characters cannot be shown in this font.</string>
