    }

    // One entry is an ordinary restyle, several (a block, a selection) one batch:
    // either way one undo step. The core picks a sibling face or a synthetic one,
    // and refuses to un-bold a font that is bold with no regular sibling.
    override fun restyleTextRuns(restyles: List<TextRunRestyle>): PdfCoreResult<Unit> = try {
        ffiRestyleTextRuns(handle, restyles.map { FfiTextRunRestyle(it.run.toFfi(), it.from.toFfi(), it.to.toFfi()) })
        PdfCoreResult.Success(Unit)
    } catch (error: FfiException.UnsupportedOperation) {
        PdfCoreResult.Failure(PdfCoreError.Failed(restyleRefusal(error.detail)))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    // The core's "cannot be made non-bold" is the app's own sentence, translated;
    // the rest as for any text block edit.
    private fun restyleRefusal(detail: String): UiText = when {
        "cannot be made non-bold" in detail -> UiText.Resource(R.string.error_content_text_bold_fixed)
        "cannot be made non-italic" in detail -> UiText.Resource(R.string.error_content_text_italic_fixed)
        else -> textBlockRefusal(detail, R.string.error_content_text_not_restyled)
    }

    // The core's sentences are a developer's, except the one that tells the reader
    // to save first (a block with an unsaved edit of another kind): that one is kept.
    private fun textBlockRefusal(detail: String, @StringRes otherwise: Int): UiText = when {
        !handle.contentEditingAllowed() -> UiText.Resource(R.string.status_content_forbidden)
        "save the document" in detail -> coreSentence(detail)
        else -> UiText.Resource(otherwise)
    }

    // The core stretches the image to `to`; the viewer picks the box, keeping its top-left corner.
