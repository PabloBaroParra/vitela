private const val LOG_TAG = "VitelaCore"

/**
 * Names the variant and hands its wording to [CoreFailure]. The diagnostic
 * detail never reaches the reader, so it goes to logcat — the only place a
 * generic sentence can still be traced back to what the core said.
 */
private fun Throwable.toPdfCoreError(): PdfCoreError {
    val (failure, detail) = when (this) {
        is FfiException.PasswordRequired -> CoreFailure.PasswordRequired to ""
        is FfiException.WrongPassword -> CoreFailure.WrongPassword to ""
        is FfiException.UnsupportedSecurityHandler -> CoreFailure.UnsupportedSecurityHandler to ""
        is FfiException.DocumentNotFound -> CoreFailure.DocumentNotFound to ""
        is FfiException.BitmapNotFound -> CoreFailure.BitmapNotFound to ""
        is FfiException.PageIndexOutOfBounds -> CoreFailure.PageIndexOutOfBounds to "page ${index}"
        is FfiException.AnnotationNotFound -> CoreFailure.AnnotationNotFound to "annotation ${annotationId}"
        is FfiException.FormFieldNotFound -> CoreFailure.FormFieldNotFound to "field ${fieldId}"
        is FfiException.InvalidImage -> CoreFailure.InvalidImage to detail
        is FfiException.InvalidSaveRequest -> CoreFailure.InvalidSaveRequest to detail
        is FfiException.SignaturesWouldBeInvalidated -> CoreFailure.SignaturesWouldBeInvalidated to ""
        is FfiException.UnsupportedOperation -> CoreFailure.UnsupportedOperation to detail
        is FfiException.EncodingGap -> CoreFailure.EncodingGap to character
        is FfiException.InvalidPageSelection -> CoreFailure.InvalidPageSelection to detail
        is FfiException.RenderFailed -> CoreFailure.RenderFailed to detail
        is FfiException.Io -> CoreFailure.Io to detail
        is FfiException.Internal -> CoreFailure.Internal to detail
        else -> CoreFailure.Unexpected to ""
    }
    // A panic or a bug on this side carries its stack; a typed refusal does not need one.
    if (failure == CoreFailure.Unexpected) Log.e(LOG_TAG, "Unexpected core failure", this)
    else Log.w(LOG_TAG, "$failure: $detail")
    return failure.toPdfCoreError(detail)
}

