        PdfCoreResult.Success(ffiSignToBytes(handle, unlocked, identityId))
    } catch (error: FfiException.UnsupportedOperation) {
        // The core's own clause: a refused document, or an identity that cannot sign.
        PdfCoreResult.Failure(PdfCoreError.Failed(coreSentence(error.detail)))
    } catch (error: FfiException.SignaturesWouldBeInvalidated) {
        PdfCoreResult.Failure(PdfCoreError.Failed(R.string.error_sign_signature_invalidated))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun saveToBytes(): PdfCoreResult<ByteArray> = try {
        // Never acknowledged: this shell has no prompt yet that tells the user
