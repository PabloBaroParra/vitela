class GeneratedPdfCoreFactory : PdfCoreFactory {
    override fun create(): PdfCore = GeneratedPdfCore()
}

private class GeneratedPdfCore : PdfCore {
    override fun openFromBytes(bytes: ByteArray, password: String?): PdfCoreResult<PdfDocument> = try {
        PdfCoreResult.Success(GeneratedPdfDocument(ffiOpenFromBytes(bytes, password)))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun openWithPasswords(bytes: ByteArray, openPassword: String, permissionsPassword: String): PdfCoreResult<PdfDocument> = try {
        PdfCoreResult.Success(GeneratedPdfDocument(ffiOpenWithPasswordsFromBytes(bytes, openPassword, permissionsPassword)))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun openSigningCertificate(bytes: ByteArray, password: String): PdfCoreResult<SigningCertificate> = try {
        PdfCoreResult.Success(GeneratedSigningCertificate(ffiOpenSigningCertificate(bytes, password)))
    } catch (error: FfiException.UnsupportedOperation) {
        // The file opened but cannot sign; `detail` is the core's clause saying
        // why, a lower-case clause like an import refusal's.
        PdfCoreResult.Failure(PdfCoreError.Failed(coreSentence(error.detail)))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    // The core asks the source's own gates here — its copy bit, its pages, what
    // it carries — and names what refused in `detail`, a lower-case clause. The
    // open document's gates are asked by `importPrepared`.
    override fun prepareImport(bytes: ByteArray, password: String?): PdfCoreResult<PreparedImport> = try {
        PdfCoreResult.Success(GeneratedPreparedImport(ffiPrepareImport(bytes, password)))
    } catch (error: FfiException.UnsupportedOperation) {
        PdfCoreResult.Failure(PdfCoreError.Failed(coreSentence(error.detail)))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }
}

/** The unlocked file crosses as an opaque object; closing it drops its private keys on the Rust side. */
private class GeneratedSigningCertificate(val certificate: FfiSigningCertificate) : SigningCertificate {
    override val identities: List<SigningIdentity> = certificate.identities().map { SigningIdentity(it.id, it.displayName) }

    override fun close() = certificate.close()
}

/** The decrypted source stays on the Rust side; closing it drops it there, unless an import already took it over. */
private class GeneratedPreparedImport(val prepared: FfiPreparedImport) : PreparedImport {
    override val pageCount: Int = prepared.pageCount().toInt()
    override val warnings: List<String> = prepared.warnings()

    override fun close() = prepared.close()
}

private class GeneratedPdfDocument(private val handle: DocumentHandle) : PdfDocument {
    override val pageCount: Int get() = handle.pageCount().toInt()

    // Not cached: a page edit reorders these and a quarter-turn swaps a page's
    // sides, and the core answers from the live page model. The viewer reads
    // them once per open and once per page edit, not per layout pass.
    override val pageSizes: List<PageSize>
        get() = handle.pageDimensions().map { PageSize(it.widthPt, it.heightPt, it.rotation.toRotation()) }

    override fun close() = handle.close()

    override fun renderPage(pageIndex: Int, dpi: Int): PdfCoreResult<RenderedPage> = try {
        val bitmap = ffiRenderPage(handle, pageIndex.toUInt(), dpi.toUInt(), FfiRenderOptions(false))
        PdfCoreResult.Success(RenderedPage(bitmap.width().toInt(), bitmap.height().toInt(), bitmap.stride().toInt(), bitmap.getPixels()))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun search(query: String): PdfCoreResult<List<SearchHit>> = try {
        PdfCoreResult.Success(handle.search(query).map { SearchHit(it.pageIndex.toInt(), it.text, it.characterBounds.map { rect -> TextRect(rect.xPt, rect.yPt, rect.widthPt, rect.heightPt) }) })
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun annotations(): PdfCoreResult<AnnotationSnapshot> = try {
        PdfCoreResult.Success(AnnotationSnapshot(handle.annotations().map { it.toAnnotation() }, handle.annotationEditingAllowed(), handle.canUndo(), handle.canRedo(),
            handle.comments().map { PdfComment(it.page.toInt(), AnnotationRect(it.rect.x, it.rect.y, it.rect.width, it.rect.height), it.contents, it.author, it.date, it.annotationId?.toLong()) }))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun applyAnnotationEdit(edit: AnnotationEdit): PdfCoreResult<Unit> = try {
        ffiApplyEdit(handle, edit.toFfi())
        PdfCoreResult.Success(Unit)
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    // No shell-side permission question, like the Windows shell: the core checks
    // the assembly bit (and whether the file survives the full rewrite a reorder
    // forces) and refuses with `UnsupportedOperation`. Named here because the
    // generic "not supported" would read as a missing feature.
    override fun applyPageEdit(edit: PageEdit): PdfCoreResult<Unit> = try {
        ffiApplyEdit(handle, edit.toFfi())
        PdfCoreResult.Success(Unit)
    } catch (error: FfiException.UnsupportedOperation) {
        PdfCoreResult.Failure(PdfCoreError.Failed(R.string.error_organize_forbidden))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    // The core asks every gate — the document's content and assembly bits, the
    // rewrite a new page forces — and names what refused in `detail`, a
    // lower-case clause. Only sources this adapter prepared can be imported:
    // the core holds the decrypted document behind the UniFFI object, not
    // behind its Kotlin face.
    override fun importPrepared(sources: List<PreparedImport>, index: Int): PdfCoreResult<BatchImportReport> = try {
        val report = ffiImportPrepared(handle, sources.map { (it as GeneratedPreparedImport).prepared }, index.toUInt())
        PdfCoreResult.Success(BatchImportReport(report.pageCount.toInt(), report.sourceIds.map { it.toLong() }))
    } catch (error: FfiException.UnsupportedOperation) {
        PdfCoreResult.Failure(PdfCoreError.Failed(coreSentence(error.detail)))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun documentBlocks(): PdfCoreResult<List<DocumentBlock>> = try {
        PdfCoreResult.Success(
            ffiDocumentBlocks(handle).map { block ->
                val source = when (val from = block.source) {
                    FfiBlockSource.Base -> BlockSource.Base
                    FfiBlockSource.Blank -> BlockSource.Blank
                    is FfiBlockSource.Imported -> BlockSource.Imported(from.id.toLong())
                }
                DocumentBlock(source, block.part?.toInt(), block.start.toInt(), block.count.toInt())
            },
        )
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun refreshPreview(): PdfCoreResult<Unit> = try {
        ffiRefreshPreview(handle)
        PdfCoreResult.Success(Unit)
    } catch (error: Throwable) {
        PdfCoreResult.Failure(PdfCoreError.Failed(R.string.error_core_preview_failed))
    }

    override fun undoAnnotations(): PdfCoreResult<Boolean> = try {
        PdfCoreResult.Success(ffiUndo(handle))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun redoAnnotations(): PdfCoreResult<Boolean> = try {
        PdfCoreResult.Success(ffiRedo(handle))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun pageCharacters(pageIndex: Int): PdfCoreResult<PageCharacters> = try {
        PdfCoreResult.Success(GeneratedPageCharacters(handle.pageCharacters(pageIndex.toUInt())))
    } catch (error: FfiException.UnsupportedOperation) {
        // The core's only refusal here is the document's /P bit forbidding
        // text extraction; the generic "could not be processed" would read
        // as a broken file.
        PdfCoreResult.Failure(PdfCoreError.Failed(R.string.error_text_selection_forbidden))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun formFields(): PdfCoreResult<List<FormField>> = try {
        PdfCoreResult.Success(handle.listFormFields().map { it.toFormField() })
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    // Bit 6, the annotation bit: filling a field in is the weaker permission,
    // not the one that lets fields be created or changed (see the FFI's
    // `form_field_editing_allowed`). The Windows shell asks the same.
    override fun formFillAllowed(): Boolean = handle.annotationEditingAllowed()

    override fun setFormFieldValue(fieldId: Long, value: FormFieldValue): PdfCoreResult<Unit> = try {
        ffiApplyEdit(handle, FfiEditCommand.SetFieldValue(fieldId.toULong(), value.toFfi()))
        PdfCoreResult.Success(Unit)
    } catch (error: FfiException.FormFieldNotFound) {
        PdfCoreResult.Failure(PdfCoreError.Failed(R.string.error_core_document_changed))
    } catch (error: FfiException.UnsupportedOperation) {
        // Either the /P bit or `pdf_form` refusing the value for the field's
        // kind; the core's own sentence is a developer's, not a reader's.
        val sentence = if (handle.annotationEditingAllowed()) R.string.error_form_value_refused else R.string.status_form_fill_forbidden
        PdfCoreResult.Failure(PdfCoreError.Failed(sentence))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    // Asked as one question: composing it from the annotation and content
    // answers would also refuse a file whose encryption cannot survive a full
    // rewrite, which a field edit never needs (see the FFI's doc).
    override fun formAuthoringAllowed(): Boolean = handle.formFieldEditingAllowed()

    override fun addFormField(pageIndex: Int, kind: NewFormField, rect: AnnotationRect): PdfCoreResult<Unit> =
        authorField(R.string.error_form_create_forbidden, R.string.error_form_create_refused) {
            val page = pageIndex.toUInt()
            val at = rect.toFfi()
            when (kind) {
                NewFormField.Text -> FfiEditCommand.AddTextField(page, at, NEW_FIELD_STYLE, false, null)
                NewFormField.Checkbox -> FfiEditCommand.AddCheckbox(page, at, NEW_FIELD_STYLE)
                // The core's two default options and its shared layout, as on Windows.
                NewFormField.RadioGroup -> FfiEditCommand.AddDefaultRadioGroup(page, at, NEW_FIELD_STYLE)
                NewFormField.Dropdown -> FfiEditCommand.AddDropdown(page, at, NEW_FIELD_STYLE, listOf("Option 1", "Option 2"), false)
            }
        }

    override fun moveFormField(fieldId: Long, to: AnnotationRect): PdfCoreResult<Unit> =
        authorField(R.string.error_form_move_forbidden, R.string.error_form_move_refused) {
            FfiEditCommand.MoveFormField(fieldId.toULong(), to.toFfi())
        }

    override fun resizeFormField(fieldId: Long, to: AnnotationRect): PdfCoreResult<Unit> =
        authorField(R.string.error_form_resize_forbidden, R.string.error_form_resize_refused) {
            FfiEditCommand.ResizeFormField(fieldId.toULong(), to.toFfi())
        }

    override fun removeFormField(fieldId: Long): PdfCoreResult<Unit> =
        authorField(R.string.error_form_delete_forbidden, R.string.error_form_delete_refused) {
            FfiEditCommand.RemoveFormField(fieldId.toULong())
        }

    // The panel refuses an empty or taken name first; a refusal here is the
    // core seeing a name the panel's list did not.
    override fun renameFormField(fieldId: Long, name: String): PdfCoreResult<Unit> =
        authorField(R.string.error_form_rename_forbidden, R.string.error_form_rename_refused) {
            FfiEditCommand.RenameFormField(fieldId.toULong(), name)
        }

    override fun restyleFormField(fieldId: Long, style: FieldTextStyle): PdfCoreResult<Unit> =
        authorField(R.string.error_form_style_forbidden, R.string.error_form_style_refused) {
            FfiEditCommand.RestyleFormField(fieldId.toULong(), style.toFfi())
        }

    private fun authorField(@StringRes forbidden: Int, @StringRes refused: Int, command: () -> FfiEditCommand): PdfCoreResult<Unit> = try {
        ffiApplyEdit(handle, command())
        PdfCoreResult.Success(Unit)
    } catch (error: FfiException.FormFieldNotFound) {
        PdfCoreResult.Failure(PdfCoreError.Failed(R.string.error_core_document_changed))
    } catch (error: FfiException.PageIndexOutOfBounds) {
        PdfCoreResult.Failure(PdfCoreError.Failed(R.string.error_core_document_changed))
    } catch (error: FfiException.UnsupportedOperation) {
        // Either the /P bits or `pdf_form` refusing the rect; the core's own
        // sentence is a developer's, not a reader's.
        PdfCoreResult.Failure(PdfCoreError.Failed(if (handle.formFieldEditingAllowed()) refused else forbidden))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun contentEditingAllowed(): Boolean = handle.contentEditingAllowed()
    override fun contentBaseGeneration(): Long = handle.contentBaseGeneration().toLong()
    override fun contentEditsCanCheckpoint(): Boolean = handle.contentEditsCanCheckpoint()

    override fun pageContent(pageIndex: Int): PdfCoreResult<PageContent> = try {
        val content = handle.readPageContent(pageIndex.toUInt())
        // Separate reads, behind the same text-extraction gate, so one refusal covers all of them.
        val paths = handle.readPagePaths(pageIndex.toUInt())
        // Paragraphs, not lines: the retype dialog is multi-line for a block of
        // several, as the Linux and Windows editors are. The core still reads a
        // composite-font paragraph line by line, so its one-line retype keeps
        // the inserted font.
        val blocks = ffiReadPageParagraphBlocks(handle, pageIndex.toUInt())
        PdfCoreResult.Success(
            PageContent(content.textRuns.map { it.toTextRun() }, content.images.map { it.toImage() }, paths.map { it.toPath() }, blocks.map { it.toBlock() }),
        )
    } catch (error: FfiException.UnsupportedOperation) {
        // The only refusal here is the /P bit forbidding text extraction.
        PdfCoreResult.Failure(PdfCoreError.Failed(R.string.error_content_read_forbidden))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    // A composite (CID) font cannot be re-encoded, so a one-line block whose first
    // run is one is retyped in the core's inserted-text font; the viewer says so
    // before the reader types. A paragraph never is: the core wraps its text, every
    // '\n' a typed line break, and refuses the inserted font for it. Every text
    // edit goes through the block API, a one-run block included: once a block is
    // retyped its first run's edit lives inside a batch, which a per-run edit
    // would no longer see. A paragraph's runs change with a retype, so the next
    // edit sends the block as the page is read again after it.
    override fun retypeTextBlock(block: ContentTextBlock, text: String): PdfCoreResult<Unit> = try {
        ffiRetypeTextBlock(handle, block.runs.map { it.toFfi() }, text, block.retypesInInsertedFont)
        PdfCoreResult.Success(Unit)
    } catch (error: FfiException.EncodingGap) {
        // Named, with the character in it: the one failure the reader can
        // clear themselves, by typing something else. The Windows wording.
        PdfCoreResult.Failure(PdfCoreError.Failed(R.string.error_core_font_gap, error.character))
    } catch (error: FfiException.UnsupportedOperation) {
        PdfCoreResult.Failure(PdfCoreError.Failed(textBlockRefusal(error.detail, R.string.error_content_text_not_edited)))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    // The original show operands are re-placed, not re-encoded, so a composite-font block keeps its font too.
    override fun moveTextBlock(block: ContentTextBlock, dx: Double, dy: Double): PdfCoreResult<Unit> = try {
        ffiMoveTextBlock(handle, block.runs.map { it.toFfi() }, dx, dy)
        PdfCoreResult.Success(Unit)
    } catch (error: FfiException.UnsupportedOperation) {
        // Also a run painted by the `"` operator, whose spacing a move would drop.
        PdfCoreResult.Failure(PdfCoreError.Failed(textBlockRefusal(error.detail, R.string.error_content_text_not_moved)))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    // No font is touched, so a composite-font block needs no substitute to be deleted.
    override fun removeTextBlock(block: ContentTextBlock): PdfCoreResult<Unit> = try {
        ffiRemoveTextBlock(handle, block.runs.map { it.toFfi() })
        PdfCoreResult.Success(Unit)
    } catch (error: FfiException.UnsupportedOperation) {
        PdfCoreResult.Failure(PdfCoreError.Failed(textBlockRefusal(error.detail, R.string.error_content_text_not_deleted)))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    // The look the Bold, Italic and Underline toggles show, a restyle queued but
    // not saved included; null when the core cannot read it.
    override fun textRunLook(run: ContentTextRun): PdfCoreResult<TextRunLookState?> = try {
        PdfCoreResult.Success(ffiTextRunLook(handle, run.toFfi())?.let { TextRunLookState(it.look.toLook(), it.canRemoveBold, it.canRemoveItalic) })
    } catch (error: Throwable) {
