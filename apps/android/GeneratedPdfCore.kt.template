    // The core's sentences are a developer's. Kept are the ones that tell the reader what to do — save first for a
    // member with an unsaved edit, and undo the paste for a fresh paste that cannot be cut — and a permission is
    // named for what it forbids: copying, or changing the content (a paste and a cut are both changes).
    private fun clipboardRefusal(detail: String, @StringRes otherwise: Int, pasting: Boolean = false): UiText = when {
        "not permitted" in detail ->
            UiText.Resource(if (!handle.contentEditingAllowed() || pasting) R.string.status_content_forbidden else R.string.error_clipboard_copy_forbidden)
        "save the document" in detail.lowercase() || "undo the paste" in detail.lowercase() -> coreSentence(detail)
        else -> UiText.Resource(otherwise)
    }

    // The core's sentences are a developer's, except the one that tells the reader to save first (a member
    // with an unsaved edit of another kind) and the one about unsaved pasted content, which are kept.
    private fun selectionRefusal(detail: String, @StringRes otherwise: Int): UiText = when {
        !handle.contentEditingAllowed() -> UiText.Resource(R.string.status_content_forbidden)
        "save the document" in detail -> coreSentence(detail)
        else -> UiText.Resource(otherwise)
    }

    // The core refuses an image with a pending edit. Every encoding is
    // replaceable: undo restores the original exactly.
    override fun prepareImageReplacement(image: ContentImage): PdfCoreResult<Unit> = try {
        handle.checkImageReplacement(image.toFfi())
        PdfCoreResult.Success(Unit)
    } catch (error: FfiException.UnsupportedOperation) {
        PdfCoreResult.Failure(PdfCoreError.Failed(imageReplacementRefusal()))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    // Checked again here, not carried from the check: an edit may have landed
    // in between.
    override fun replaceImage(image: ContentImage, imageBytes: ByteArray): PdfCoreResult<Unit> = try {
        val item = image.toFfi()
        handle.checkImageReplacement(item)
        ffiApplyEdit(handle, FfiEditCommand.ReplaceImageSource(item, imageBytes))
        PdfCoreResult.Success(Unit)
    } catch (error: FfiException.InvalidImage) {
        PdfCoreResult.Failure(PdfCoreError.Failed(NOT_AN_IMAGE))
    } catch (error: FfiException.UnsupportedOperation) {
        PdfCoreResult.Failure(PdfCoreError.Failed(imageReplacementRefusal()))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    // The core's sentences are a developer's; this one names what the reader can do.
    @StringRes
    private fun imageReplacementRefusal(): Int =
        if (handle.contentEditingAllowed()) {
            R.string.error_content_image_not_replaced
        } else {
            R.string.status_content_forbidden
        }

    // A new line gets a Helvetica resource of its own. The core reuses a font
    // already registered under the name it is given, so the name must be one
    // the page does not declare — checked against every declared font, used
    // or not — and random, so two queued inserts, invisible to that check,
    // cannot share one either. The Windows shell's scheme.
    override fun insertTextRun(pageIndex: Int, text: String, bounds: AnnotationRect): PdfCoreResult<Unit> = try {
        val declared = handle.pageFontFamilies(pageIndex.toUInt())
        var fontName: String
        do { fontName = "VitelaText" + UUID.randomUUID().toString().replace("-", "") } while (fontName in declared)
        ffiApplyEdit(handle, FfiEditCommand.InsertTextRun(FfiContentTextRun(0u, pageIndex.toUInt(), bounds.toFfi(), fontName, FfiFontKind.STANDARD14, text)))
        PdfCoreResult.Success(Unit)
    } catch (error: FfiException.EncodingGap) {
        PdfCoreResult.Failure(PdfCoreError.Failed(R.string.error_content_helvetica_gap, error.character))
    } catch (error: FfiException.UnsupportedOperation) {
        val sentence = if (handle.contentEditingAllowed()) R.string.error_content_text_not_added else R.string.status_content_forbidden
        PdfCoreResult.Failure(PdfCoreError.Failed(sentence))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

