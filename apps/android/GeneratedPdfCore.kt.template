private fun PageEdit.toFfi(): FfiEditCommand = when (this) {
    is PageEdit.Move -> FfiEditCommand.MovePages(from.toUInt(), count.toUInt(), to.toUInt())
    is PageEdit.Rotate ->
        if (count == 1) FfiEditCommand.RotatePage(pageIndex.toUInt(), deltaDegrees)
        else FfiEditCommand.RotatePages(pageIndex.toUInt(), count.toUInt(), deltaDegrees)
    is PageEdit.Remove ->
        if (count == 1) FfiEditCommand.RemovePage(pageIndex.toUInt())
        else FfiEditCommand.RemovePages(pageIndex.toUInt(), count.toUInt())
    is PageEdit.InsertBlank -> FfiEditCommand.InsertBlankPage(index.toUInt(), FfiPageSize.A4, if (landscape) FfiOrientation.LANDSCAPE else FfiOrientation.PORTRAIT)
}

