class GeneratedPdfCoreFactory : PdfCoreFactory {
    override fun create(): PdfCore = GeneratedPdfCore()
}

private class GeneratedPdfCore : PdfCore {
    override fun openFromBytes(bytes: ByteArray, password: String?): PdfCoreResult<PdfDocument> = try {
        PdfCoreResult.Success(GeneratedPdfDocument(ffiOpenFromBytes(bytes, password)))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun openWithPasswords(bytes: ByteArray, openPassword: String, permissionsPassword: String): PdfCoreResult<PdfDocument> = try {
        PdfCoreResult.Success(GeneratedPdfDocument(ffiOpenWithPasswordsFromBytes(bytes, openPassword, permissionsPassword)))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }
}

private class GeneratedPdfDocument(private val handle: DocumentHandle) : PdfDocument {
    override val pageCount: Int get() = handle.pageCount().toInt()

    // Not cached: a page edit reorders these and a quarter-turn swaps a page's
    // sides, and the core answers from the live page model. The viewer reads
    // them once per open and once per page edit, not per layout pass.
    override val pageSizes: List<PageSize>
        get() = handle.pageDimensions().map { PageSize(it.widthPt, it.heightPt) }

    override fun close() = handle.close()

    override fun renderPage(pageIndex: Int, dpi: Int): PdfCoreResult<RenderedPage> = try {
        val bitmap = ffiRenderPage(handle, pageIndex.toUInt(), dpi.toUInt(), FfiRenderOptions(false))
        PdfCoreResult.Success(RenderedPage(bitmap.width().toInt(), bitmap.height().toInt(), bitmap.stride().toInt(), bitmap.getPixels()))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun search(query: String): PdfCoreResult<List<SearchHit>> = try {
        PdfCoreResult.Success(handle.search(query).map { SearchHit(it.pageIndex.toInt(), it.text, it.characterBounds.map { rect -> TextRect(rect.xPt, rect.yPt, rect.widthPt, rect.heightPt) }) })
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun annotations(): PdfCoreResult<AnnotationSnapshot> = try {
        PdfCoreResult.Success(AnnotationSnapshot(handle.annotations().map { it.toAnnotation() }, handle.annotationEditingAllowed(), handle.canUndo(), handle.canRedo()))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun applyAnnotationEdit(edit: AnnotationEdit): PdfCoreResult<Unit> = try {
        ffiApplyEdit(handle, edit.toFfi())
        PdfCoreResult.Success(Unit)
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    // No shell-side permission question, like the Windows shell: the core checks
    // the assembly bit (and whether the file survives the full rewrite a reorder
    // forces) and refuses with `UnsupportedOperation`. Named here because the
    // generic "not supported" would read as a missing feature.
    override fun applyPageEdit(edit: PageEdit): PdfCoreResult<Unit> = try {
        ffiApplyEdit(handle, edit.toFfi())
        PdfCoreResult.Success(Unit)
    } catch (error: FfiException.UnsupportedOperation) {
        PdfCoreResult.Failure(PdfCoreError.Failed("This document does not allow its pages to be rearranged, rotated or removed."))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun refreshPreview(): PdfCoreResult<Unit> = try {
        ffiRefreshPreview(handle)
        PdfCoreResult.Success(Unit)
    } catch (error: Throwable) {
        PdfCoreResult.Failure(PdfCoreError.Failed("The page could not be redrawn with your changes. They are still pending save."))
    }

    override fun undoAnnotations(): PdfCoreResult<Boolean> = try {
        PdfCoreResult.Success(ffiUndo(handle))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun redoAnnotations(): PdfCoreResult<Boolean> = try {
        PdfCoreResult.Success(ffiRedo(handle))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun pageCharacters(pageIndex: Int): PdfCoreResult<PageCharacters> = try {
        PdfCoreResult.Success(GeneratedPageCharacters(handle.pageCharacters(pageIndex.toUInt())))
    } catch (error: FfiException.UnsupportedOperation) {
        // The core's only refusal here is the document's /P bit forbidding
        // text extraction; the generic "could not be processed" would read
        // as a broken file.
        PdfCoreResult.Failure(PdfCoreError.Failed("This document does not allow its text to be selected or copied."))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun formFields(): PdfCoreResult<List<FormField>> = try {
        PdfCoreResult.Success(handle.listFormFields().map { it.toFormField() })
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    // Bit 6, the annotation bit: filling a field in is the weaker permission,
    // not the one that lets fields be created or changed (see the FFI's
    // `form_field_editing_allowed`). The Windows shell asks the same.
    override fun formFillAllowed(): Boolean = handle.annotationEditingAllowed()

    override fun setFormFieldValue(fieldId: Long, value: FormFieldValue): PdfCoreResult<Unit> = try {
        ffiApplyEdit(handle, FfiEditCommand.SetFieldValue(fieldId.toULong(), value.toFfi()))
        PdfCoreResult.Success(Unit)
    } catch (error: FfiException.FormFieldNotFound) {
        PdfCoreResult.Failure(PdfCoreError.Failed("The document changed. Please try again."))
    } catch (error: FfiException.UnsupportedOperation) {
        // Either the /P bit or `pdf_form` refusing the value for the field's
        // kind; the core's own sentence is a developer's, not a reader's.
        val sentence = if (handle.annotationEditingAllowed()) "That value does not fit this field." else "This document does not permit filling in its form."
        PdfCoreResult.Failure(PdfCoreError.Failed(sentence))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    // Asked as one question: composing it from the annotation and content
    // answers would also refuse a file whose encryption cannot survive a full
    // rewrite, which a field edit never needs (see the FFI's doc).
    override fun formAuthoringAllowed(): Boolean = handle.formFieldEditingAllowed()

    override fun addFormField(pageIndex: Int, kind: NewFormField, rect: AnnotationRect): PdfCoreResult<Unit> =
        authorField("This document does not permit creating form fields.", "This field cannot be placed there.") {
            val page = pageIndex.toUInt()
            val at = rect.toFfi()
            when (kind) {
                NewFormField.Text -> FfiEditCommand.AddTextField(page, at, NEW_FIELD_STYLE, false, null)
                NewFormField.Checkbox -> FfiEditCommand.AddCheckbox(page, at, NEW_FIELD_STYLE)
                // The core's two default options and its shared layout, as on Windows.
                NewFormField.RadioGroup -> FfiEditCommand.AddDefaultRadioGroup(page, at, NEW_FIELD_STYLE)
                NewFormField.Dropdown -> FfiEditCommand.AddDropdown(page, at, NEW_FIELD_STYLE, listOf("Option 1", "Option 2"), false)
            }
        }

    override fun moveFormField(fieldId: Long, to: AnnotationRect): PdfCoreResult<Unit> =
        authorField("This document does not permit moving form fields.", "This field cannot be moved there.") {
            FfiEditCommand.MoveFormField(fieldId.toULong(), to.toFfi())
        }

    override fun resizeFormField(fieldId: Long, to: AnnotationRect): PdfCoreResult<Unit> =
        authorField("This document does not permit resizing form fields.", "This field cannot be that size.") {
            FfiEditCommand.ResizeFormField(fieldId.toULong(), to.toFfi())
        }

    private fun authorField(forbidden: String, refused: String, command: () -> FfiEditCommand): PdfCoreResult<Unit> = try {
        ffiApplyEdit(handle, command())
        PdfCoreResult.Success(Unit)
    } catch (error: FfiException.FormFieldNotFound) {
        PdfCoreResult.Failure(PdfCoreError.Failed("The document changed. Please try again."))
    } catch (error: FfiException.PageIndexOutOfBounds) {
        PdfCoreResult.Failure(PdfCoreError.Failed("The document changed. Please try again."))
    } catch (error: FfiException.UnsupportedOperation) {
        // Either the /P bits or `pdf_form` refusing the rect; the core's own
        // sentence is a developer's, not a reader's.
        PdfCoreResult.Failure(PdfCoreError.Failed(if (handle.formFieldEditingAllowed()) refused else forbidden))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun contentEditingAllowed(): Boolean = handle.contentEditingAllowed()

    override fun pageContent(pageIndex: Int): PdfCoreResult<PageContent> = try {
        val content = handle.readPageContent(pageIndex.toUInt())
        PdfCoreResult.Success(PageContent(content.textRuns.map { it.toTextRun() }, content.images.map { it.toImage() }))
    } catch (error: FfiException.UnsupportedOperation) {
        // The only refusal here is the /P bit forbidding text extraction.
        PdfCoreResult.Failure(PdfCoreError.Failed("This document does not allow its text to be read."))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    // A composite (CID) font cannot be re-encoded, so its run is retyped in the
    // core's inserted-text font; the viewer says so before the reader types.
    override fun retypeTextRun(run: ContentTextRun, text: String): PdfCoreResult<Unit> = try {
        val item = run.toFfi()
        ffiApplyEdit(
            handle,
            if (run.fontKind == ContentFontKind.EmbeddedComposite) FfiEditCommand.ReplaceTextRunWithInsertedFont(item, text)
            else FfiEditCommand.ReplaceTextRunContent(item, text),
        )
        PdfCoreResult.Success(Unit)
    } catch (error: FfiException.EncodingGap) {
        // Named, with the character in it: the one failure the reader can
        // clear themselves, by typing something else. The Windows wording.
        PdfCoreResult.Failure(PdfCoreError.Failed("This text's font cannot show \"${error.character}\". Try different characters."))
    } catch (error: FfiException.UnsupportedOperation) {
        // The /P bit, or `pdf_edit` declining this run or its stream encoding;
        // the core's own sentence is a developer's, not a reader's.
        val sentence = if (handle.contentEditingAllowed()) "This text cannot be edited." else "This document does not permit content changes."
        PdfCoreResult.Failure(PdfCoreError.Failed(sentence))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    // The core stretches the image to `to`; the viewer picks the box, keeping its top-left corner.
    override fun resizeImage(image: ContentImage, to: AnnotationRect): PdfCoreResult<Unit> = try {
        ffiApplyEdit(handle, FfiEditCommand.ResizeImage(image.toFfi(), to.toFfi()))
        PdfCoreResult.Success(Unit)
    } catch (error: FfiException.UnsupportedOperation) {
        // The /P bit, a document that cannot be rewritten whole, or `pdf_edit`
        // declining this image; the core's own sentence is a developer's.
        val sentence = if (handle.contentEditingAllowed()) "This image cannot be resized." else "This document does not permit content changes."
        PdfCoreResult.Failure(PdfCoreError.Failed(sentence))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    // Same rewrite as a resize, told apart by intent in the undo log; the viewer keeps the size.
    override fun moveImage(image: ContentImage, to: AnnotationRect): PdfCoreResult<Unit> = try {
        ffiApplyEdit(handle, FfiEditCommand.MoveImage(image.toFfi(), to.toFfi()))
        PdfCoreResult.Success(Unit)
    } catch (error: FfiException.UnsupportedOperation) {
        val sentence = if (handle.contentEditingAllowed()) "This image cannot be moved." else "This document does not permit content changes."
        PdfCoreResult.Failure(PdfCoreError.Failed(sentence))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun documentInfo(): PdfCoreResult<DocumentInfo> = try {
        PdfCoreResult.Success(handle.readDocumentInfo().toDocumentInfo())
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    // The core does not gate `SetDocumentInfo` itself; this is the same
    // permission the Windows shell asks before offering the properties.
    override fun metadataEditingAllowed(): Boolean = handle.contentEditingAllowed()

    override fun setDocumentInfo(info: DocumentInfo): PdfCoreResult<Unit> = try {
        // Re-read so the file's creation/modification dates ride along: the
        // command replaces the whole dict, and this shell never edits them.
        val after = handle.readDocumentInfo().copy(
            title = info.title,
            author = info.author,
            subject = info.subject,
            keywords = info.keywords,
            creator = info.creator,
            producer = info.producer,
        )
        ffiApplyEdit(handle, FfiEditCommand.SetDocumentInfo(after))
        PdfCoreResult.Success(Unit)
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    // The same /P bit text extraction asks (extract): a page image is exactly
    // that, and nothing is modified, so the modify bit is not the question.
    override fun imageExportAllowed(): Boolean = handle.textExtractionAllowed()

    // Aliased FFI calls throughout: the member and the binding share a name.
    override fun parsePageSelection(input: String): PdfCoreResult<List<Int>> = try {
        PdfCoreResult.Success(ffiParsePageSelection(input, pageCount.toUInt()).map { it.toInt() })
    } catch (error: FfiException.InvalidPageSelection) {
        // The core's own sentence, written for the person who typed the range.
        PdfCoreResult.Failure(PdfCoreError.Failed(error.detail))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun pageImageFileName(displayName: String, pageIndex: Int, format: ImageExportFormat): PdfCoreResult<String> = try {
        PdfCoreResult.Success(ffiPageImageFileName(displayName, pageIndex.toUInt(), pageCount.toUInt(), format.toFfi()))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun firstPageTooLargeToExport(pages: List<Int>, dpi: Int): PdfCoreResult<Int?> = try {
        PdfCoreResult.Success(ffiFirstPageTooLargeToExport(handle, pages.map { it.toUInt() }, dpi.toUInt())?.toInt())
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun exportPageImage(pageIndex: Int, dpi: Int, format: ImageExportFormat): PdfCoreResult<ByteArray> = try {
        PdfCoreResult.Success(ffiExportPageImage(handle, pageIndex.toUInt(), dpi.toUInt(), format.toFfi()))
    } catch (error: FfiException.UnsupportedOperation) {
        PdfCoreResult.Failure(PdfCoreError.Failed("This document does not permit extracting its pages as images."))
    } catch (error: FfiException.RenderFailed) {
        // PDFium already drew this document's pages, so a render failure here
        // is the raster ceiling at this DPI, not a missing library.
        PdfCoreResult.Failure(PdfCoreError.Failed("It could not be rendered at $dpi DPI. Choose a lower resolution."))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    // The extraction bit, like image export: pages leave, nothing is modified.
    override fun pageExtractionAllowed(): Boolean = handle.textExtractionAllowed()

    override fun fullRewriteAllowed(): Boolean = handle.fullRewriteAllowed()

    override fun extractSourceIsSigned(): Boolean = ffiExtractSourceIsSigned(handle)

    override fun extractPages(pages: List<Int>): PdfCoreResult<ByteArray> = try {
        PdfCoreResult.Success(ffiExtractPagesToPdf(handle, pages.map { it.toUInt() }))
    } catch (error: FfiException.UnsupportedOperation) {
        // Both gates are asked in the plan, so this is the prune itself refusing;
        // its detail is a lower-case clause, not a sentence of its own.
        PdfCoreResult.Failure(PdfCoreError.Failed("These pages could not be extracted: ${error.detail}."))
    } catch (error: FfiException.InvalidPageSelection) {
        PdfCoreResult.Failure(PdfCoreError.Failed(error.detail))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun planSplit(cuts: String, displayName: String): PdfCoreResult<List<SplitPart>> = try {
        PdfCoreResult.Success(
            ffiPlanSplit(cuts, pageCount.toUInt(), displayName).map { SplitPart(it.first.toInt(), it.last.toInt(), it.fileName) },
        )
    } catch (error: FfiException.InvalidPageSelection) {
        // The core's own sentence: a blank field, a one-page file, a bad cut.
        PdfCoreResult.Failure(PdfCoreError.Failed(error.detail))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun compressionRefusal(): String? =
        ffiCompressionRefusal(handle, FfiSaveIntent.DEFAULT)?.toClause()

    override fun compressedSaveWillInvalidateSignatures(): PdfCoreResult<Boolean> = try {
        PdfCoreResult.Success(ffiCompressedSaveWillInvalidateSignatures(handle, FfiSaveIntent.DEFAULT))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun saveCompressed(preset: CompressPreset, signaturesAcknowledged: Boolean): PdfCoreResult<CompressedCopy> = try {
        val acknowledgement = if (signaturesAcknowledged) FfiSignatureAcknowledgement.PROCEED_AND_INVALIDATE else FfiSignatureAcknowledgement.UNACKNOWLEDGED
        val saved = ffiSaveCompressedToBytes(handle, FfiSaveIntent.DEFAULT, acknowledgement, preset.toFfi())
        val report = saved.report
        PdfCoreResult.Success(
            CompressedCopy(
                bytes = saved.bytes,
                beforeBytes = report.beforeBytes.toLong(),
                afterBytes = report.afterBytes.toLong(),
                savedBytes = report.savedBytes.toLong(),
                reduced = report.outcome == FfiCompressOutcome.REDUCED,
                refusals = report.refusals.map { it.toClause() },
            ),
        )
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    // The same bit Windows gates Protect on: changing a file's protection is a content change.
    override fun protectionChangeAllowed(): Boolean = handle.contentEditingAllowed()

    override fun protectionWillInvalidateSignatures(): PdfCoreResult<Boolean> = try {
        PdfCoreResult.Success(ffiProtectionWillInvalidateSignatures(handle))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun protect(openPassword: String, permissionsPassword: String, signaturesAcknowledged: Boolean): PdfCoreResult<ByteArray> = try {
        val acknowledgement = if (signaturesAcknowledged) FfiSignatureAcknowledgement.PROCEED_AND_INVALIDATE else FfiSignatureAcknowledgement.UNACKNOWLEDGED
        PdfCoreResult.Success(ffiProtectToBytes(handle, openPassword, permissionsPassword, acknowledgement))
    } catch (error: FfiException.InvalidSaveRequest) {
        // The core's own clause (a missing password, or two that match) as a sentence.
        PdfCoreResult.Failure(PdfCoreError.Failed("${error.detail.replaceFirstChar { it.uppercaseChar() }}."))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun saveToBytes(): PdfCoreResult<ByteArray> = try {
        // Never acknowledged: this shell has no prompt yet that tells the user
        // a save breaks the file's signature, so the core refuses the save.
        PdfCoreResult.Success(ffiSaveToBytes(handle, FfiSaveIntent.DEFAULT, FfiSignatureAcknowledgement.UNACKNOWLEDGED))
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun stampPlacement(imageBytes: ByteArray, anchor: AnnotationPoint): PdfCoreResult<AnnotationRect> = try {
        PdfCoreResult.Success(ffiStampPlacement(imageBytes, anchor.x, anchor.y).toRect())
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }

    override fun insertImageStamp(pageIndex: Int, imageBytes: ByteArray, rect: AnnotationRect): PdfCoreResult<Unit> = try {
        ffiInsertImageStamp(handle, pageIndex.toUInt(), imageBytes, rect.toFfi())
        PdfCoreResult.Success(Unit)
    } catch (error: Throwable) {
        PdfCoreResult.Failure(error.toPdfCoreError())
    }
}

/** Carets cross as `u32`; the core clamps an out-of-range caret, so the casts cannot panic it. */
private class GeneratedPageCharacters(private val characters: FfiPageCharacters) : PageCharacters {
    override fun caretAt(point: AnnotationPoint): Int? = characters.caretAt(point.x.toFloat(), point.y.toFloat())?.toInt()

    override fun textIn(anchor: Int, focus: Int): String = characters.textIn(anchor.toUInt(), focus.toUInt())

    override fun rectsIn(anchor: Int, focus: Int): List<TextRect> =
        characters.rectsIn(anchor.toUInt(), focus.toUInt()).map { TextRect(it.xPt, it.yPt, it.widthPt, it.heightPt) }

    override fun close() = characters.close()
}

private fun dev.vitela.pdf.uniffi.FfiAnnotation.toAnnotation(): Annotation = when (val value = kind) {
    is FfiAnnotationKind.Highlight -> Annotation(id.toLong(), page.toInt(), AnnotationKind.Highlight, value.rect.toRect(), value.color.toColor())
    is FfiAnnotationKind.Underline -> Annotation(id.toLong(), page.toInt(), AnnotationKind.Underline, value.rect.toRect(), value.color.toColor())
    is FfiAnnotationKind.Strikeout -> Annotation(id.toLong(), page.toInt(), AnnotationKind.Strikeout, value.rect.toRect(), value.color.toColor())
    is FfiAnnotationKind.Ink -> Annotation(id.toLong(), page.toInt(), AnnotationKind.Ink, null, value.color.toColor(), value.points.map { AnnotationPoint(it.x, it.y) })
    is FfiAnnotationKind.Shape -> Annotation(id.toLong(), page.toInt(), AnnotationKind.Shape, value.rect.toRect(), value.color.toColor())
    is FfiAnnotationKind.TextNote -> Annotation(id.toLong(), page.toInt(), AnnotationKind.TextNote, value.rect.toRect(), null)
    is FfiAnnotationKind.Stamp -> Annotation(id.toLong(), page.toInt(), AnnotationKind.Stamp, value.rect.toRect(), null)
}

private fun AnnotationEdit.toFfi(): FfiEditCommand = when (this) {
    is AnnotationEdit.Add -> when (annotation.kind) {
        AnnotationKind.Highlight -> FfiEditCommand.AddHighlight(annotation.pageIndex.toUInt(), requireNotNull(annotation.rect).toFfi(), requireNotNull(annotation.color).toFfi())
        AnnotationKind.Underline -> FfiEditCommand.AddUnderline(annotation.pageIndex.toUInt(), requireNotNull(annotation.rect).toFfi(), requireNotNull(annotation.color).toFfi())
        AnnotationKind.Strikeout -> FfiEditCommand.AddStrikeout(annotation.pageIndex.toUInt(), requireNotNull(annotation.rect).toFfi(), requireNotNull(annotation.color).toFfi())
        AnnotationKind.Ink -> FfiEditCommand.AddInk(annotation.pageIndex.toUInt(), annotation.points.map { FfiPoint(it.x, it.y) }, requireNotNull(annotation.color).toFfi())
        AnnotationKind.Shape -> FfiEditCommand.AddShape(annotation.pageIndex.toUInt(), requireNotNull(annotation.rect).toFfi(), requireNotNull(annotation.color).toFfi())
        AnnotationKind.TextNote -> FfiEditCommand.AddTextNote(annotation.pageIndex.toUInt(), requireNotNull(annotation.rect).toFfi(), "Note")
        AnnotationKind.Stamp -> error("Use insertImageStamp for image-backed stamps")
    }
    is AnnotationEdit.Move -> FfiEditCommand.MoveAnnotation(id.toULong(), dx, dy)
    is AnnotationEdit.Resize -> FfiEditCommand.ResizeAnnotation(id.toULong(), rect.toFfi())
    is AnnotationEdit.Restyle -> FfiEditCommand.RestyleAnnotation(id.toULong(), color.toFfi())
    is AnnotationEdit.Remove -> FfiEditCommand.RemoveAnnotation(id.toULong())
}

// A move is one page: the block form the core takes is Windows' `MovePages(from, 1, to)`.
private fun FfiFormField.toFormField() = FormField(id.toLong(), page.toInt(), name, kind.toFormFieldKind(), value.toFormFieldValue(), rect.toRect())

// A new field's first style: the Windows shell's Helvetica 12 pt black.
private val NEW_FIELD_STYLE = FfiTextStyle(FfiFontFamily.HELVETICA, 12.0, FfiColor(0u, 0u, 0u))

private fun FfiFormFieldKind.toFormFieldKind(): FormFieldKind = when (this) {
    is FfiFormFieldKind.Text -> FormFieldKind.Text(multiline, maxLen?.let { minOf(it, Int.MAX_VALUE.toUInt()).toInt() })
    is FfiFormFieldKind.Checkbox -> FormFieldKind.Checkbox
    is FfiFormFieldKind.RadioGroup -> FormFieldKind.RadioGroup(options.map { it.exportValue })
    is FfiFormFieldKind.Dropdown -> FormFieldKind.Dropdown(options, editable)
}

private fun FfiFieldValue.toFormFieldValue(): FormFieldValue = when (this) {
    is FfiFieldValue.Text -> FormFieldValue.Text(text)
    is FfiFieldValue.Checked -> FormFieldValue.Checked(checked)
    is FfiFieldValue.Choice -> FormFieldValue.Choice(option)
}

private fun FormFieldValue.toFfi(): FfiFieldValue = when (this) {
    is FormFieldValue.Text -> FfiFieldValue.Text(text)
    is FormFieldValue.Checked -> FfiFieldValue.Checked(checked)
    is FormFieldValue.Choice -> FfiFieldValue.Choice(option)
}

private fun PageEdit.toFfi(): FfiEditCommand = when (this) {
    is PageEdit.Move -> FfiEditCommand.MovePages(from.toUInt(), 1u, to.toUInt())
    is PageEdit.Rotate -> FfiEditCommand.RotatePage(pageIndex.toUInt(), deltaDegrees)
    is PageEdit.Remove -> FfiEditCommand.RemovePage(pageIndex.toUInt())
    is PageEdit.InsertBlank -> FfiEditCommand.InsertBlankPage(index.toUInt(), FfiPageSize.A4, if (landscape) FfiOrientation.LANDSCAPE else FfiOrientation.PORTRAIT)
}

private fun FfiContentTextRun.toTextRun() = ContentTextRun(id.toLong(), page.toInt(), bbox.toRect(), resourceFontName, fontKind.toFontKind(), text)

// Rebuilt field for field: the core matches a retype against the parse it came from.
private fun FfiContentImageItem.toImage() = ContentImage(id.toLong(), page.toInt(), bbox.toRect(), resourceXobjectName)

private fun ContentImage.toFfi() = FfiContentImageItem(id.toULong(), pageIndex.toUInt(), bounds.toFfi(), resourceName)

private fun ContentTextRun.toFfi() = FfiContentTextRun(id.toULong(), pageIndex.toUInt(), bounds.toFfi(), resourceFontName, fontKind.toFfi(), text)

private fun FfiFontKind.toFontKind(): ContentFontKind = when (this) {
    FfiFontKind.STANDARD14 -> ContentFontKind.Standard14
    FfiFontKind.EMBEDDED_SIMPLE -> ContentFontKind.EmbeddedSimple
    FfiFontKind.EMBEDDED_COMPOSITE -> ContentFontKind.EmbeddedComposite
}

private fun ContentFontKind.toFfi(): FfiFontKind = when (this) {
    ContentFontKind.Standard14 -> FfiFontKind.STANDARD14
    ContentFontKind.EmbeddedSimple -> FfiFontKind.EMBEDDED_SIMPLE
    ContentFontKind.EmbeddedComposite -> FfiFontKind.EMBEDDED_COMPOSITE
}

private fun ImageExportFormat.toFfi(): FfiExportFormat = when (this) {
    ImageExportFormat.Png -> FfiExportFormat.PNG
    ImageExportFormat.Jpeg -> FfiExportFormat.JPEG
}

private fun CompressPreset.toFfi(): FfiCompressPreset = when (this) {
    CompressPreset.Lossless -> FfiCompressPreset.LOSSLESS
    CompressPreset.Balanced -> FfiCompressPreset.BALANCED
    CompressPreset.Small -> FfiCompressPreset.SMALL
}

// The two modelled refusals cross without text, so their wording is restated
// here from `pdf_compress::Refusal`'s Display — verbatim the Windows adapter's.
private fun FfiCompressRefusal.toClause(): String = when (this) {
    is FfiCompressRefusal.EncryptedDocumentNotRewritable -> "this document's password protection does not allow it to be rewritten, so it cannot be compressed"
    is FfiCompressRefusal.SignaturesWouldBeInvalidated -> "compressing rewrites the file and would stop its signature from verifying"
    is FfiCompressRefusal.Other -> detail
}

private fun FfiDocumentInfo.toDocumentInfo() = DocumentInfo(title, author, subject, keywords, creator, producer)
private fun FfiRect.toRect() = AnnotationRect(x, y, width, height)
private fun AnnotationRect.toFfi() = FfiRect(x, y, width, height)
private fun FfiColor.toColor() = AnnotationColor(r.toInt(), g.toInt(), b.toInt())
private fun AnnotationColor.toFfi() = FfiColor(red.toUByte(), green.toUByte(), blue.toUByte())

private fun Throwable.toPdfCoreError(): PdfCoreError = when (this) {
    is FfiException.PasswordRequired -> PdfCoreError.PasswordRequired
    is FfiException.WrongPassword -> PdfCoreError.WrongPassword
    is FfiException.SignaturesWouldBeInvalidated -> PdfCoreError.Failed("Saving would invalidate this document's signature, so it was not saved.")
    is FfiException.RenderFailed -> PdfCoreError.Failed("PDFium is unavailable. This package must include externally supplied compatible PDFium libraries.")
    else -> PdfCoreError.Failed("The document could not be processed.")
}
