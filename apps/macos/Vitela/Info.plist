<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged with the keys Xcode generates (GENERATE_INFOPLIST_FILE). Only what
  has no INFOPLIST_KEY_ build setting lives here: the document types that let
  Finder offer Vitela in Open With and send it double-clicked or Dock-dropped
  PDFs. "Alternate" so installing a development build never takes PDFs away
  from the user's default viewer. VitelaVersion is the release semver the
  build was handed (VITELA_VERSION), read by AppVersion.swift; empty means a
  development build.
-->
<plist version="1.0">
<dict>
	<key>VitelaVersion</key>
	<string>$(VITELA_VERSION)</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PDF Document</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
