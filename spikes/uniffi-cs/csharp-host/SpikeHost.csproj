<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Bindings are generated by uniffi-bindgen-cs into ./generated before
         `dotnet build` runs (see spike.ps1 / spike.sh). Not checked in as a
         hand-maintained file; regenerate whenever the Rust interface changes.
         The SDK's default glob already picks up generated/**/*.cs — no
         explicit <Compile> item needed (adding one causes NETSDK1022
         duplicate-item errors). -->
  </PropertyGroup>

</Project>
